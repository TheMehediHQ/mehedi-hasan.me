# Last.fm (server-side only — never exposed to the browser)
LASTFM_USERNAME=your_lastfm_username
LASTFM_API_KEY=your_lastfm_api_key

# Resend (Contact Form)
RESEND_API_KEY=re_your_api_key_here

# Last Visitor feature
UPSTASH_REDIS_REST_URL=https://your-instance.upstash.io
UPSTASH_REDIS_REST_TOKEN=your_upstash_token
IP_GEOLOCATION_API_URL=http://ip-api.com/json
IP_GEOLOCATION_API_KEY=

# Buttondown (Newsletter)
BUTTONDOWN_API_KEY=your_buttondown_api_key

# AI Portfolio Assistant (Server-side only — never exposed to client)
AI_API_KEY=your_ai_api_key_here
AI_MODEL=gpt-4o-mini
# Optional custom base URL (e.g. https://api.openai.com/v1, https://api.groq.com/openai/v1, https://openrouter.ai/api/v1)
# AI_BASE_URL=https://api.openai.com/v1
