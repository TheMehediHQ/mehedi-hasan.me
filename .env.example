# ============================================
# Mehedi Hasan Portfolio - Environment Variables
# ============================================
# Copy this file to .env and fill in your values

# Last.fm (InsightSection - Now Playing)
LASTFM_USERNAME=your_lastfm_username
LASTFM_API_KEY=your_lastfm_api_key

# Resend (Contact Form)
RESEND_API_KEY=re_your_api_key_here
RESEND_FROM_EMAIL=Your Name <your@email.com>
CONTACT_TO_EMAIL=your@email.com

# Upstash Redis (Rate Limiting + Last Visitor)
UPSTASH_REDIS_REST_URL=https://your-instance.upstash.io
UPSTASH_REDIS_REST_TOKEN=your_upstash_token

# IP Geolocation (Last Visitor feature)
# Free tier: http://ip-api.com — no API key needed, 45 req/min
IP_GEOLOCATION_API_URL=http://ip-api.com/json
IP_GEOLOCATION_API_KEY=

# Buttondown (Newsletter)
BUTTONDOWN_API_KEY=your_buttondown_api_key

# AI Portfolio Assistant (Server-side only — never exposed to client)
# Supports: Groq, OpenAI, OpenRouter, Gemini
# For Groq: https://console.groq.com
GROQ_API_KEY=your_groq_api_key_here
AI_MODEL=qwen/qwen3.8-27b

# Optional: Use a different AI provider
# AI_API_KEY=your_ai_api_key_here
# AI_BASE_URL=https://api.openai.com/v1
