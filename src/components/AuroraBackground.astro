---
interface Props {
  class?: string;
}

const { class: className = "" } = Astro.props;
---

<div class:list={["aurora-root", className]}>
  <!-- Aurora Beam -->
  <div class="aurora-beam" aria-hidden="true"></div>

  <!-- Content Slot -->
  <div class="aurora-content">
    <slot />
  </div>
</div>

<style>
  .aurora-root {
    position: relative;
    min-height: 100vh;
    overflow: hidden;
    background-color: #0b0f17;
  }

  .aurora-beam {
    position: absolute;
    top: -40%;
    left: 50%;
    width: 160%;
    height: 80vh;
    transform: translateX(-50%);
    pointer-events: none;
    background: conic-gradient(
      from 180deg at 50% 0%,
      transparent 0deg,
      #06b6d4 20deg,
      #3b82f6 50deg,
      #7c3aed 80deg,
      #f59e0b 110deg,
      #10b981 140deg,
      transparent 160deg
    );
    filter: blur(80px);
    opacity: 0.45;
    mask-image: linear-gradient(
      to bottom,
      rgba(0, 0, 0, 1) 0%,
      rgba(0, 0, 0, 0.6) 40%,
      rgba(0, 0, 0, 0) 70%
    );
    -webkit-mask-image: linear-gradient(
      to bottom,
      rgba(0, 0, 0, 1) 0%,
      rgba(0, 0, 0, 0.6) 40%,
      rgba(0, 0, 0, 0) 70%
    );
    animation: aurora-spin 25s linear infinite, aurora-pulse 8s ease-in-out infinite;
    will-change: transform;
  }

  @keyframes aurora-spin {
    from {
      transform: translateX(-50%) rotate(0deg);
    }
    to {
      transform: translateX(-50%) rotate(360deg);
    }
  }

  @keyframes aurora-pulse {
    0%, 100% {
      opacity: 0.45;
      transform: translateX(-50%) scale(1);
    }
    50% {
      opacity: 0.55;
      transform: translateX(-50%) scale(1.05);
    }
  }

  .aurora-content {
    position: relative;
    z-index: 10;
  }
</style>
