---
interface Props {
  date: Date | string;
}

const { date } = Astro.props;
const currentLocale = Astro.currentLocale ?? 'en';
const formattedDate = new Date(date).toLocaleDateString(
  currentLocale === 'bn' ? 'bn-BD' : 'en-US',
  {
    year: 'numeric',
    month: 'long',
    day: 'numeric',
  }
);
---

<time datetime={new Date(date).toISOString()}>
  {formattedDate}
</time>
