---
import { Icon } from "astro-icon/components";
---

<button
  class="theme-toggle-btn flex h-8 w-8 items-center justify-center rounded-lg transition-colors hover:bg-[var(--nav-active-bg)]"
  type="button"
  aria-label="Toggle theme"
  style="color: var(--color-primary-text);"
>
  <Icon name="lucide:moon" class="theme-icon-moon h-4 w-4" />
  <Icon name="lucide:sun" class="theme-icon-sun h-4 w-4 hidden" />
</button>

<script>
  const buttons = document.querySelectorAll(".theme-toggle-btn");

  const updateAllIcons = () => {
    const isDark = document.documentElement.classList.contains("dark");
    document.querySelectorAll(".theme-icon-moon").forEach((el) => {
      el.classList.toggle("hidden", isDark);
    });
    document.querySelectorAll(".theme-icon-sun").forEach((el) => {
      el.classList.toggle("hidden", !isDark);
    });
  };

  buttons.forEach((button) => {
    button.addEventListener("click", () => {
      const html = document.documentElement;
      const isDark = html.classList.contains("dark");

      html.classList.toggle("dark", !isDark);
      localStorage.setItem("theme", !isDark ? "dark" : "light");

      updateAllIcons();
    });
  });

  updateAllIcons();
</script>
