---
import { cn } from "@/lib/utils";

interface Props {
  class?: string;
  style?: string;
  variant?: "default" | "dark" | "accent" | "image" | "interactive";
  href?: string;
  target?: string;
  rel?: string;
  padding?: "none" | "sm" | "md" | "lg";
}

const {
  class: className = "",
  style: styleProp = "",
  variant = "default",
  href,
  target,
  rel,
  padding = "md",
} = Astro.props;

const Tag = href ? "a" : "div";

const paddingMap = {
  none: "",
  sm: "p-4 sm:p-5",
  md: "p-5 sm:p-6",
  lg: "p-6 sm:p-8 lg:p-10",
};

const variantMap = {
  default:
    "border border-[var(--color-border)] bg-[var(--color-surface)] transition-all duration-200 hover:border-[var(--color-accent)]/20 hover:shadow-[0_0_20px_rgba(96,165,250,0.04)]",
  dark: "border border-[var(--color-border)] bg-[var(--color-surface)] text-[var(--color-primary-text)] transition-all duration-200 hover:border-[var(--color-accent)]/20 hover:shadow-[0_0_20px_rgba(96,165,250,0.04)]",
  accent:
    "border border-[var(--color-accent)]/30 bg-[var(--color-accent)]/5",
  image: "border border-[var(--color-border)] bg-[var(--color-surface)] overflow-hidden",
  interactive:
    "border border-[var(--color-border)] bg-[var(--color-surface)] transition-all duration-200 hover:border-[var(--color-hover-border)] hover:bg-[var(--color-hover)]",
};
---

<Tag
  href={href}
  target={target}
  rel={href ? (rel ?? (target === "_blank" ? "noopener noreferrer" : undefined)) : undefined}
  class={cn(
    "rounded-2xl lg:rounded-3xl",
    variantMap[variant],
    paddingMap[padding],
    className
  )}
  style={styleProp}
>
  <slot />
</Tag>
