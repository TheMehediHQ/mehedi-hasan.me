---
import { personalInfo } from "@/data/personalInfo";
import { socials } from "@/data/socials";
import { experiences } from "@/data/experience";
import { skills } from "@/data/skills";
import { educations } from "@/data/education";

import { Icon } from "astro-icon/components";

import DhakaTimeCard from "@/components/live-signals/DhakaTimeCard.astro";
import LocationCard from "@/components/live-signals/LocationCard.astro";
import LastFmCard from "@/components/live-signals/LastFmCard.astro";
import HeroCTA from "@/components/ui/HeroCTA.astro";
import BentoCard from "./BentoCard.astro";

const socialPreviewMap: Record<string, string> = {
  LinkedIn: "/images/linkedin.webp",
  GitHub: "/images/github.webp",
  X: "/images/x.webp",
};

const connectItems = [
  {
    label: "hello@mehedi-hasan.me",
    href: "mailto:hello@mehedi-hasan.me",
  },
  ...socials.map((social) => ({
    ...social,
    ...(socialPreviewMap[social.label]
      ? { previewImage: socialPreviewMap[social.label] }
      : {}),
  })),
  {
    label: "Resume",
    href: personalInfo.resume,
  },
];

const recentExperience = experiences.slice(0, 3);

const iconMap: Record<string, string> = {
  React: "simple-icons:react",
  "Next.js": "simple-icons:nextdotjs",
  TypeScript: "simple-icons:typescript",
  JavaScript: "simple-icons:javascript",
  "Node.js": "simple-icons:nodedotjs",
  Python: "simple-icons:python",
  OpenAI: "simple-icons:openai",
  FastAPI: "simple-icons:fastapi",
  PostgreSQL: "simple-icons:postgresql",
  MongoDB: "simple-icons:mongodb",
  Docker: "simple-icons:docker",
  AWS: "simple-icons:amazonaws",
  Git: "simple-icons:git",
  Linux: "simple-icons:linux",
};

const skillsByCategory = {
  Frontend: skills.filter(
    (skill) =>
      skill.category === "Frontend" ||
      ["React", "Next.js", "TypeScript", "JavaScript"].includes(skill.name),
  ),

  Backend: skills.filter(
    (skill) =>
      skill.category === "Backend" ||
      ["Node.js", "FastAPI"].includes(skill.name),
  ),

  "AI / LLM": skills.filter(
    (skill) =>
      skill.category === "AI/ML" ||
      skill.category === "AI/LLM" ||
      ["Python", "OpenAI"].includes(skill.name),
  ),

  Data: skills.filter(
    (skill) =>
      skill.category === "Database" ||
      ["PostgreSQL", "MongoDB"].includes(skill.name),
  ),

  DevOps: skills.filter(
    (skill) =>
      skill.category === "DevOps" ||
      skill.category === "Cloud" ||
      skill.category === "Tools" ||
      ["Docker", "AWS", "Git", "Linux"].includes(skill.name),
  ),
};

const visibleSkillGroups = Object.entries(skillsByCategory).filter(
  ([, categorySkills]) => categorySkills.length > 0,
);

const projects = [
  {
    name: "AY Voice",
    href: "https://ayvoice.com",
    video: "/projects/ayvoice.webm",
    year: "2026",
    tech: ["Next.js", "OpenAI", "PostgreSQL"],
    type: "AI SaaS",
  },
  {
    name: "NexVibe",
    href: "https://nexvibe.tech",
    video: "/projects/mexvibe.webm",
    year: "2025",
    tech: ["Next.js", "TypeScript", "AWS"],
    type: "Web Platform",
  },
  {
    name: "Kashly",
    href: "https://kashly.mehedi-hasan.me",
    video: "/projects/kashly.webm",
    year: "2024",
    tech: ["React", "Node.js", "MongoDB"],
    type: "Full Stack",
  },
];
---

<section
  id="home"
  data-bento-section
  aria-labelledby="hero-title"
  class="flex items-center justify-center px-3 py-5 sm:px-5 sm:py-8 lg:px-6 lg:py-10"
>
  <div class="w-full max-w-[1200px]">
    <div
      class="bento-grid grid grid-cols-1 gap-3 sm:grid-cols-2 lg:grid-cols-12"
      style="grid-auto-rows: minmax(112px, auto);"
    >
      <!-- Hero -->
      <BentoCard
        variant="dark"
        padding="md"
        class="bento-animate relative overflow-hidden sm:col-span-2 lg:col-span-8"
        data-delay="0s"
      >
        <div class="relative flex h-full flex-col justify-between gap-5">
          <div class="flex items-start gap-3 sm:gap-4">
            <img
              src={personalInfo.profile}
              alt="Mehedi Hasan"
              width={56}
              height={56}
              loading="eager"
              fetchpriority="high"
              class="h-12 w-12 shrink-0 rounded-full object-cover ring-2 ring-[var(--color-accent)]/30 sm:h-14 sm:w-14"
            />

            <div class="min-w-0 flex-1">
              <h1
                id="hero-title"
                class="text-xl font-bold tracking-tight text-[var(--color-primary-text)] sm:text-2xl"
              >
                Hey, I'm Mehedi Hasan
              </h1>

              <div class="mt-1.5 flex flex-wrap items-center gap-x-2 gap-y-1">
                <span
                  class="inline-flex items-center gap-1.5 text-xs font-semibold text-[var(--color-accent)]"
                >
                  <span
                    class="h-1.5 w-1.5 rounded-full bg-[var(--color-accent)]"
                    aria-hidden="true"
                  ></span>
                  AI/LLM Developer
                </span>

                <span
                  class="text-xs text-[var(--color-muted-text)] sm:text-sm"
                >
                  Full Stack Developer
                </span>
              </div>
            </div>
          </div>

          <!-- Static Bio -->
          <div
            class="max-w-2xl space-y-3 text-sm leading-6 text-[var(--color-secondary-text)] sm:text-[15px]"
          >
            <p>
              I'm a Full-Stack & AI Developer from Bangladesh focused on
              building modern, scalable, and reliable software with React,
              Next.js, TypeScript, and Node.js, with a strong focus on AI/LLM
              development and intelligent applications.
            </p>

            <p>
              I turn complex ideas into practical products with clean
              architecture, thoughtful UX, and scalable engineering.
            </p>
          </div>

          <div class="pt-0.5">
            <HeroCTA items={connectItems} />
          </div>
        </div>
      </BentoCard>

      <!-- Tech Stack -->
      <BentoCard
        variant="dark"
        padding="md"
        class="bento-animate flex h-full flex-col sm:col-span-1 lg:col-span-4"
        data-delay="0.08s"
      >
        <div class="mb-3 flex items-center justify-between gap-2">
          <h2
            class="text-sm font-semibold text-[var(--color-primary-text)]"
          >
            Tech Stack
          </h2>

          <Icon
            name="lucide:layers-3"
            class="h-4 w-4 text-[var(--color-muted-text)]"
            aria-hidden="true"
          />
        </div>

        <div class="flex flex-1 flex-col gap-3">
          {
            visibleSkillGroups.map(([category, categorySkills]) => (
              <div>
                <p
                  class="mb-1.5 text-[10px] font-medium text-[var(--color-muted-text)]"
                >
                  {category}
                </p>

                <div class="flex flex-wrap gap-1.5">
                  {categorySkills.map((skill) => (
                    <span
                      class="inline-flex items-center gap-1.5 rounded-md border border-[var(--color-border)] px-2 py-1 text-[11px] font-medium text-[var(--color-secondary-text)]"
                    >
                      {iconMap[skill.name] && (
                        <Icon
                          name={iconMap[skill.name]}
                          class="h-3 w-3 shrink-0 opacity-65"
                          aria-hidden="true"
                        />
                      )}

                      {skill.name}
                    </span>
                  ))}
                </div>
              </div>
            ))
          }
        </div>
      </BentoCard>

      <!-- Experience -->
      <BentoCard
        variant="dark"
        padding="lg"
        class="bento-animate sm:col-span-2 lg:col-span-8"
        data-delay="0.12s"
      >
        <div class="flex h-full flex-col">
          <div class="mb-4 flex items-center justify-between gap-2 sm:mb-5">
            <h2
              class="text-sm font-semibold text-[var(--color-primary-text)]"
            >
              Experience
            </h2>
          </div>

          <div class="flex-1 divide-y divide-[var(--color-border)]">
            {
              recentExperience.map((exp) => (
                <div class="flex items-start justify-between gap-4 py-3 first:pt-0 last:pb-0">
                  <div class="min-w-0">
                    <h3 class="text-sm font-semibold text-[var(--color-primary-text)]">
                      {exp.role}
                    </h3>

                    <p class="mt-0.5 text-xs text-[var(--color-muted-text)]">
                      {exp.company}
                    </p>
                  </div>

                  <span class="shrink-0 whitespace-nowrap text-right text-[11px] text-[var(--color-muted-text)] sm:text-xs">
                    {exp.period}
                  </span>
                </div>
              ))
            }
          </div>
        </div>
      </BentoCard>

      <!-- Education -->
      <BentoCard
        variant="dark"
        padding="md"
        class="bento-animate flex flex-col sm:col-span-1 lg:col-span-4"
        data-delay="0.16s"
      >
        <div class="mb-3 flex items-center justify-between gap-2">
          <h2
            class="text-sm font-semibold text-[var(--color-primary-text)]"
          >
            Education
          </h2>

          <Icon
            name="lucide:graduation-cap"
            class="h-4 w-4 text-[var(--color-muted-text)]"
            aria-hidden="true"
          />
        </div>

        <div class="flex flex-col divide-y divide-[var(--color-border)]">
          {
            educations.map((edu) => (
              <article class="py-3 first:pt-0 last:pb-0">
                <h3 class="text-sm font-bold leading-snug text-[var(--color-primary-text)]">
                  {edu.degree}
                </h3>

                <p class="mt-1 text-xs leading-5 text-[var(--color-secondary-text)]">
                  {edu.institution}
                </p>

                <p class="mt-1 text-[11px] text-[var(--color-muted-text)]">
                  {edu.period}
                </p>

                {edu.subjects?.length > 0 && (
                  <div class="mt-2 flex flex-wrap gap-1.5">
                    {edu.subjects.map((subject) => (
                      <span class="rounded-md bg-[var(--color-hover)] px-2 py-1 text-[10px] text-[var(--color-muted-text)]">
                        {subject}
                      </span>
                    ))}
                  </div>
                )}
              </article>
            ))
          }
        </div>
      </BentoCard>

      <!-- Selected Projects -->
      <div class="col-span-full">
        <div class="grid grid-cols-1 gap-3 sm:grid-cols-2 lg:grid-cols-3">
          {
            projects.map((project, index) => (
              <BentoCard
                variant="image"
                padding="none"
                class="bento-animate group relative min-h-[240px] overflow-hidden sm:min-h-[260px] lg:min-h-[270px]"
                data-delay={`${0.2 + index * 0.05}s`}
              >
                <a
                  href={project.href}
                  target="_blank"
                  rel="noopener noreferrer"
                  aria-label={`View ${project.name} project (opens in a new tab)`}
                  class="relative block h-full min-h-[240px] w-full sm:min-h-[260px] lg:min-h-[270px]"
                >
                  <div
                    class="absolute inset-0 overflow-hidden rounded-xl border border-[var(--color-border)]"
                    aria-hidden="true"
                  >
                    <video
                      src={project.video}
                      autoplay
                      loop
                      muted
                      playsinline
                      preload="metadata"
                      class="h-full w-full object-cover transition-transform duration-500 group-hover:scale-105 motion-reduce:transition-none"
                    ></video>

                    <div class="absolute inset-0 bg-gradient-to-t from-black/90 via-black/35 to-transparent"></div>
                  </div>

                  <div class="relative flex h-full min-h-[240px] flex-col justify-between px-4 pb-4 pt-3 sm:min-h-[260px] lg:min-h-[270px]">
                    <div class="flex items-start justify-between gap-2">
                      <span class="text-[10px] font-medium text-white/75">
                        {project.type}
                      </span>

                      <span class="text-xs text-white/60">
                        {project.year}
                      </span>
                    </div>

                    <div>
                      <div class="flex items-center gap-1.5">
                        <h3 class="text-base font-bold text-white sm:text-lg">
                          {project.name}
                        </h3>

                        <Icon
                          name="lucide:arrow-up-right"
                          class="h-4 w-4 text-white/70 transition-transform group-hover:translate-x-0.5 group-hover:-translate-y-0.5"
                          aria-hidden="true"
                        />
                      </div>

                      <div class="mt-2 flex flex-wrap gap-1">
                        {project.tech.map((technology) => (
                          <span class="rounded bg-black/20 px-1.5 py-0.5 text-[10px] font-medium text-white/75">
                            {technology}
                          </span>
                        ))}
                      </div>
                    </div>
                  </div>
                </a>
              </BentoCard>
            ))
          }
        </div>
      </div>

      <!-- GitHub Activity -->
      <BentoCard
        variant="dark"
        padding="md"
        class="bento-animate sm:col-span-2 lg:col-span-8"
        data-delay="0.35s"
      >
        <div class="flex flex-col">
          <div class="mb-2 flex items-center justify-between gap-2">
            <h2
              class="text-sm font-semibold text-[var(--color-primary-text)]"
            >
              GitHub Activity
            </h2>

            <a
              href="https://github.com/TheMehediHQ"
              target="_blank"
              rel="noopener noreferrer"
              class="inline-flex items-center gap-1 text-[11px] text-[var(--color-muted-text)] transition-colors hover:text-[var(--color-accent)]"
            >
              View profile

              <Icon
                name="lucide:arrow-up-right"
                class="h-3 w-3"
                aria-hidden="true"
              />
            </a>
          </div>

          <div class="overflow-x-auto">
            <img
              src="https://ghchart.rshah.org/themehedihq"
              alt="GitHub contribution activity chart for Mehedi Hasan"
              width="760"
              height="120"
              loading="lazy"
              class="h-auto min-w-[280px] w-full rounded-lg opacity-85"
            />
          </div>
        </div>
      </BentoCard>

      <!-- Blog -->
      <BentoCard
        variant="dark"
        padding="md"
        class="bento-animate group sm:col-span-1 lg:col-span-4"
        data-delay="0.4s"
      >
        <a
          href="/blog"
          class="flex h-full min-h-[110px] flex-col justify-between"
        >
          <div>
            <div class="mb-2 flex items-center justify-between gap-2">
              <h2
                class="text-lg font-bold text-[var(--color-primary-text)]"
              >
                Blog
              </h2>

              <Icon
                name="lucide:book-open"
                class="h-4 w-4 text-[var(--color-muted-text)]"
                aria-hidden="true"
              />
            </div>

            <p class="text-xs leading-5 text-[var(--color-muted-text)]">
              Writing about software, AI and what I'm learning along the way.
            </p>
          </div>

          <span
            class="secondary-btn mt-4 inline-flex w-fit items-center gap-2 rounded-full border px-4 py-2 text-xs font-medium text-[var(--color-primary-text)]"
          >
            View posts

            <Icon
              name="lucide:arrow-up-right"
              class="h-3.5 w-3.5 transition-transform group-hover:translate-x-0.5"
              aria-hidden="true"
            />
          </span>
        </a>
      </BentoCard>

      <!-- Live Signals -->
      <div
        class="col-span-full grid grid-cols-1 gap-3 sm:grid-cols-2 lg:grid-cols-4"
      >
        <BentoCard
          variant="dark"
          padding="none"
          class="bento-animate min-w-0"
          data-delay="0.45s"
        >
          <DhakaTimeCard />
        </BentoCard>

        <BentoCard
          variant="dark"
          padding="none"
          class="bento-animate min-w-0"
          data-delay="0.5s"
        >
          <LocationCard />
        </BentoCard>

        <BentoCard
          variant="dark"
          padding="none"
          class="bento-animate min-w-0"
          data-delay="0.55s"
        >
          <LastFmCard />
        </BentoCard>

        <!-- Contact -->
        <BentoCard
          variant="dark"
          padding="md"
          class="bento-animate group min-w-0"
          data-delay="0.6s"
        >
          <a
            href="/contact"
            class="flex h-full min-h-[140px] flex-col justify-between"
          >
            <div>
              <div class="flex items-center gap-2">
                <span
                  class="relative flex h-2 w-2"
                  aria-hidden="true"
                >
                  <span
                    class="absolute inline-flex h-full w-full animate-ping rounded-full bg-green-400 opacity-75 motion-reduce:animate-none"
                  ></span>

                  <span
                    class="relative inline-flex h-2 w-2 rounded-full bg-green-500"
                  ></span>
                </span>

                <span
                  class="text-[10px] font-semibold uppercase tracking-wider text-green-400"
                >
                  Available for work
                </span>
              </div>

              <h2
                class="mt-2 text-lg font-bold text-[var(--color-primary-text)]"
              >
                Let's collaborate
              </h2>

              <p
                class="mt-1 text-xs leading-5 text-[var(--color-muted-text)]"
              >
                Open to full-time roles and interesting projects.
              </p>
            </div>

            <span
              class="primary-btn mt-4 inline-flex w-fit items-center gap-2 rounded-full bg-[var(--color-accent)] px-4 py-2 text-xs font-semibold text-[var(--color-button-primary-text)] transition-all hover:bg-[var(--color-accent-hover)] hover:shadow-lg hover:shadow-[var(--color-accent)]/20"
            >
              Get in touch

              <Icon
                name="lucide:arrow-up-right"
                class="h-3.5 w-3.5 transition-transform group-hover:translate-x-0.5"
                aria-hidden="true"
              />
            </span>
          </a>
        </BentoCard>
      </div>
    </div>
  </div>
</section>

<style>
  .bento-animate {
    opacity: 1;
    transform: none;
    transition:
      opacity 0.45s ease,
      transform 0.45s ease;
  }

  .bento-animate.has-motion:not(.is-visible) {
    opacity: 0;
    transform: translateY(10px);
  }

  .bento-animate.is-visible {
    opacity: 1;
    transform: translateY(0);
    transition-delay: var(--animation-delay, 0s);
  }

  @media (prefers-reduced-motion: reduce) {
    .bento-animate,
    .bento-animate.has-motion:not(.is-visible) {
      opacity: 1 !important;
      transform: none !important;
      transition: none !important;
    }
  }
</style>

<script>
  const section =
    document.querySelector<HTMLElement>("[data-bento-section]");

  if (section) {
    const animatedElements = Array.from(
      section.querySelectorAll<HTMLElement>(".bento-animate"),
    );

    animatedElements.forEach((element) => {
      const delay = element.dataset.delay;

      if (delay) {
        element.style.setProperty("--animation-delay", delay);
      }
    });

    const reduceMotion = window.matchMedia(
      "(prefers-reduced-motion: reduce)",
    ).matches;

    if (
      reduceMotion ||
      !("IntersectionObserver" in window)
    ) {
      animatedElements.forEach((element) => {
        element.classList.add("is-visible");
      });
    } else {
      animatedElements.forEach((element) => {
        element.classList.add("has-motion");
      });

      const observer = new IntersectionObserver(
        (entries, currentObserver) => {
          entries.forEach((entry) => {
            if (!entry.isIntersecting) return;

            entry.target.classList.add("is-visible");
            currentObserver.unobserve(entry.target);
          });
        },
        {
          threshold: 0.05,
          rootMargin: "0px 0px 40px 0px",
        },
      );

      animatedElements.forEach((element) => {
        observer.observe(element);
      });
    }
  }
</script>