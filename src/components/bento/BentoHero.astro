---
import { personalInfo } from "@/data/personalInfo";
import { socials } from "@/data/socials";
import { experiences } from "@/data/experience";
import { skills } from "@/data/skills";
import HeroCTA from "@/components/ui/HeroCTA.astro";
import BentoCard from "./BentoCard.astro";

const socialPreviewMap: Record<string, string> = {
  LinkedIn: "/images/linkedin.webp",
  GitHub: "/images/github.webp",
  X: "/images/x.webp",
};

const connectItems = [
  { label: "hello@mehedi-hasan.me", href: "mailto:hello@mehedi-hasan.me" },
  ...socials.map((s) => ({
    ...s,
    ...(socialPreviewMap[s.label] ? { previewImage: socialPreviewMap[s.label] } : {}),
  })),
  { label: "Resume", href: personalInfo.resume },
];

const recentExperience = experiences.slice(0, 3);
---

<section
  id="home"
  data-bento-section
  aria-labelledby="hero-title"
  class="flex items-center justify-center px-4 py-8 sm:px-8 sm:py-12 lg:px-16"
>
  <div class="w-full max-w-[1200px]">

    <!-- BENTO HERO GRID — 4 columns (BenBox style) -->
    <div
      class="grid gap-3 sm:gap-4"
      style="grid-template-columns: repeat(4, 1fr); grid-auto-rows: minmax(120px, auto);"
    >

      <!-- ===== 01. ABOUT (col 1-2, row 1) ===== -->
      <BentoCard
        variant="dark"
        padding="lg"
        class="bento-animate"
        style="grid-column: span 2;"
        data-delay="0s"
      >
        <div class="flex h-full flex-col justify-between">
          <span class="inline-flex w-fit rounded-full bg-[#C8FF00] px-3 py-1 text-xs font-bold uppercase tracking-wide text-black">
            About
          </span>
          <div class="mt-4">
            <p
              id="hero-title"
              class="text-sm leading-7 text-white/80 sm:text-base sm:leading-7"
            >
              {personalInfo.bio}
            </p>
          </div>
        </div>
      </BentoCard>

      <!-- ===== 02. PROFILE / AVAILABILITY (col 3, row 1) ===== -->
      <BentoCard
        variant="dark"
        padding="md"
        class="bento-animate flex flex-col items-center justify-center gap-4"
        style="grid-column: span 1;"
        data-delay="0.05s"
      >
        <div class="relative flex h-28 w-28 sm:h-32 sm:w-32 items-center justify-center rounded-full border-2 border-[#C8FF00]/40 bg-[#C8FF00]/10 overflow-hidden">
          <img
            src={personalInfo.profile}
            alt="Mehedi Hasan"
            width={2500}
            height={2500}
            loading="eager"
            fetchpriority="high"
            class="h-full w-full object-cover"
          />
        </div>
        <div class="flex items-center gap-2">
          <span class="relative flex h-2.5 w-2.5 shrink-0">
            <span
              class="absolute inline-flex h-full w-full animate-ping rounded-full opacity-75 motion-reduce:hidden"
              style="background-color: #C8FF00;"
            ></span>
            <span
              class="relative inline-flex h-2.5 w-2.5 rounded-full"
              style="background-color: #C8FF00;"
            ></span>
          </span>
          <span class="text-xs font-medium text-white/70 uppercase tracking-wide">
            Available
          </span>
        </div>
      </BentoCard>

      <!-- ===== 03. FEATURED PROJECT — AY Voice (col 4, row 1-2) ===== -->
      <BentoCard
        variant="image"
        padding="none"
        class="bento-animate group"
        style="grid-column: span 1; grid-row: span 2;"
        data-delay="0.1s"
      >
        <a
          href="https://ayvoice.com"
          target="_blank"
          rel="noopener noreferrer"
          class="relative block h-full w-full overflow-hidden"
        >
          <img
            src="/projects/ayvoice.webp"
            alt="AY Voice"
            width={1600}
            height={1000}
            loading="eager"
            class="absolute inset-0 h-full w-full object-cover transition-transform duration-500 group-hover:scale-105"
          />
          <div class="absolute inset-0 bg-gradient-to-t from-black/80 via-black/20 to-transparent"></div>
          <div class="absolute top-4 left-4">
            <span class="inline-flex rounded-full bg-[#C8FF00] px-3 py-1 text-xs font-bold uppercase tracking-wide text-black">
              Case Study
            </span>
          </div>
          <div class="absolute bottom-0 left-0 right-0 p-4 sm:p-5">
            <h3 class="text-lg font-semibold text-white sm:text-xl">AY Voice</h3>
            <p class="mt-1 text-xs text-white/60 line-clamp-2">
              Cloud-based bulk SMS & voice calling platform
            </p>
          </div>
        </a>
      </BentoCard>

      <!-- ===== 04. LINKEDIN HIGHLIGHT (col 1, row 2) ===== -->
      <BentoCard
        variant="dark"
        padding="none"
        class="bento-animate flex items-center justify-center"
        style="grid-column: span 1; background: linear-gradient(135deg, #0A66C2 0%, #004182 100%);"
        data-delay="0.12s"
      >
        <a
          href="https://linkedin.com/in/themehedihq"
          target="_blank"
          rel="noopener noreferrer"
          class="flex h-full w-full items-center justify-center p-6 group"
        >
          <svg viewBox="0 0 24 24" class="h-14 w-14 sm:h-16 sm:w-16 text-white transition-transform duration-300 group-hover:scale-110" fill="currentColor">
            <path d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433a2.062 2.062 0 01-2.063-2.065 2.064 2.064 0 112.063 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z"/>
          </svg>
        </a>
      </BentoCard>

      <!-- ===== 05. EXPERIENCE (col 2-3, row 2-3) ===== -->
      <BentoCard
        variant="dark"
        padding="lg"
        class="bento-animate"
        style="grid-column: span 2; grid-row: span 2;"
        data-delay="0.15s"
      >
        <div class="flex h-full flex-col">
          <span class="inline-flex w-fit rounded-full bg-[#C8FF00] px-3 py-1 text-xs font-bold uppercase tracking-wide text-black mb-5">
            Experience
          </span>
          <div class="flex-1 space-y-0 divide-y divide-white/10">
            {recentExperience.map((exp) => (
              <div class="flex items-start justify-between py-3.5 first:pt-0 last:pb-0">
                <div>
                  <h4 class="text-sm font-semibold text-white">{exp.role}</h4>
                  <p class="text-xs text-white/50 mt-0.5">{exp.company}</p>
                </div>
                <span class="text-xs text-white/40 whitespace-nowrap ml-4">{exp.period}</span>
              </div>
            ))}
          </div>
          <a
            href={personalInfo.resume}
            target="_blank"
            rel="noopener noreferrer"
            class="mt-4 inline-flex w-fit items-center gap-2 rounded-full border border-white/20 px-4 py-2 text-xs font-medium text-white transition-colors hover:bg-white/10"
          >
            View resume
            <svg class="h-3.5 w-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="7" y1="17" x2="17" y2="7"/><polyline points="7 7 17 7 17 17"/></svg>
          </a>
        </div>
      </BentoCard>

      <!-- ===== 06. TECH STACK ICONS (col 1, row 3) ===== -->
      <BentoCard
        variant="dark"
        padding="md"
        class="bento-animate flex flex-col"
        style="grid-column: span 1;"
        data-delay="0.18s"
      >
        <span class="inline-flex w-fit rounded-full bg-[#C8FF00] px-3 py-1 text-xs font-bold uppercase tracking-wide text-black mb-4">
          Stack
        </span>
        <div class="grid grid-cols-4 gap-3 flex-1">
          {skills.map((skill) => (
            <div class="group flex flex-col items-center gap-1.5">
              <img
                src={`/tech/${skill.icon || "default.svg"}`}
                alt={skill.name}
                width="28"
                height="28"
                loading="lazy"
                class="object-contain transition-transform duration-200 group-hover:scale-110"
              />
              <span class="text-[8px] text-white/40 truncate w-full text-center hidden group-hover:block">
                {skill.name}
              </span>
            </div>
          ))}
        </div>
      </BentoCard>

      <!-- ===== 07. CASE STUDY 2 — NexVibe (col 4, row 3-4) ===== -->
      <BentoCard
        variant="image"
        padding="none"
        class="bento-animate group"
        style="grid-column: span 1; grid-row: span 2;"
        data-delay="0.2s"
      >
        <a
          href="https://nexvibe.tech"
          target="_blank"
          rel="noopener noreferrer"
          class="relative block h-full w-full overflow-hidden"
        >
          <img
            src="/projects/nexvibe.webp"
            alt="NexVibe"
            width={1600}
            height={1000}
            loading="lazy"
            class="absolute inset-0 h-full w-full object-cover transition-transform duration-500 group-hover:scale-105"
          />
          <div class="absolute inset-0 bg-gradient-to-t from-black/80 via-black/20 to-transparent"></div>
          <div class="absolute top-4 left-4">
            <span class="inline-flex rounded-full bg-[#C8FF00] px-3 py-1 text-xs font-bold uppercase tracking-wide text-black">
              Case Study
            </span>
          </div>
          <div class="absolute bottom-0 left-0 right-0 p-4 sm:p-5">
            <h3 class="text-lg font-semibold text-white sm:text-xl">NexVibe</h3>
            <p class="mt-1 text-xs text-white/60">Software agency website</p>
          </div>
        </a>
      </BentoCard>

      <!-- ===== 08. OPEN SOURCE — Kashly (col 1-2, row 4) ===== -->
      <BentoCard
        variant="image"
        padding="none"
        class="bento-animate group"
        style="grid-column: span 2;"
        data-delay="0.22s"
      >
        <a
          href="https://kashly.mehedi-hasan.me"
          target="_blank"
          rel="noopener noreferrer"
          class="relative block h-full w-full overflow-hidden"
        >
          <img
            src="/projects/kashly.webp"
            alt="Kashly"
            width={1600}
            height={1000}
            loading="lazy"
            class="absolute inset-0 h-full w-full object-cover transition-transform duration-500 group-hover:scale-105"
          />
          <div class="absolute inset-0 bg-gradient-to-t from-black/80 via-black/20 to-transparent"></div>
          <div class="absolute top-4 left-4">
            <span class="inline-flex rounded-full bg-[#C8FF00] px-3 py-1 text-xs font-bold uppercase tracking-wide text-black">
              Open Source
            </span>
          </div>
          <div class="absolute bottom-0 left-0 right-0 p-4 sm:p-5">
            <h3 class="text-lg font-semibold text-white sm:text-xl">Kashly</h3>
            <p class="mt-1 text-xs text-white/60">Money management app</p>
          </div>
        </a>
      </BentoCard>

      <!-- ===== 09. FOCUS (col 3, row 4) ===== -->
      <BentoCard
        variant="dark"
        padding="md"
        class="bento-animate flex flex-col justify-between"
        style="grid-column: span 1;"
        data-delay="0.24s"
      >
        <div>
          <span class="inline-flex w-fit rounded-full bg-[#C8FF00] px-3 py-1 text-xs font-bold uppercase tracking-wide text-black mb-4">
            Focus
          </span>
          <h3 class="text-base font-semibold text-white mt-3">Scalable<br />Products</h3>
        </div>
        <p class="text-xs leading-5 text-white/50 mt-3">
          AI-powered apps, modern web architecture, and reliable systems.
        </p>
      </BentoCard>

      <!-- ===== 10. CONNECT / CTA (col 1-3, row 5) ===== -->
      <BentoCard
        variant="dark"
        padding="md"
        class="bento-animate"
        style="grid-column: span 3;"
        data-delay="0.26s"
      >
        <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-4">
          <div>
            <p class="text-xs uppercase tracking-[0.18em] text-white/50 mb-1">Connect with me</p>
            <h3 class="text-lg font-semibold text-white sm:text-xl">Let's build something.</h3>
          </div>
          <div class="flex-shrink-0">
            <HeroCTA items={connectItems} />
          </div>
        </div>
      </BentoCard>

    </div>

    <!-- SOCIAL LINKS ROW -->
    <div class="mt-3 sm:mt-4 grid grid-cols-5 gap-2 sm:gap-3">
      {socials.map((social, i) => (
        <a
          href={social.href}
          target="_blank"
          rel="noopener noreferrer"
          class="bento-animate flex flex-col items-center justify-center gap-2 rounded-2xl border border-white/[0.08] bg-[#161616] p-3 sm:p-4 transition-colors hover:border-[#C8FF00]/40 hover:bg-[#C8FF00]/5"
          style={`transition-delay: ${0.28 + i * 0.03}s`}
        >
          <span class="text-white/60">
            {social.icon === "fa6-brands:github" && (
              <svg class="h-5 w-5 sm:h-6 sm:w-6" viewBox="0 0 24 24" fill="currentColor"><path d="M12 0c-6.626 0-12 5.373-12 12 0 5.302 3.438 9.8 8.207 11.387.599.111.793-.261.793-.577v-2.234c-3.338.726-4.033-1.416-4.033-1.416-.546-1.387-1.333-1.756-1.333-1.756-1.089-.745.083-.729.083-.729 1.205.084 1.839 1.237 1.839 1.237 1.07 1.834 2.807 1.304 3.492.997.107-.775.418-1.305.762-1.604-2.665-.305-5.467-1.334-5.467-5.931 0-1.311.469-2.381 1.236-3.221-.124-.303-.535-1.524.117-3.176 0 0 1.008-.322 3.301 1.23.957-.266 1.983-.399 3.003-.404 1.02.005 2.047.138 3.006.404 2.291-1.552 3.297-1.23 3.297-1.23.653 1.653.242 2.874.118 3.176.77.84 1.235 1.911 1.235 3.221 0 4.609-2.807 5.624-5.479 5.921.43.372.823 1.102.823 2.222v3.293c0 .319.192.694.801.576 4.765-1.589 8.199-6.086 8.199-11.386 0-6.627-5.373-12-12-12z"/></svg>
            )}
            {social.icon === "fa6-brands:linkedin" && (
              <svg class="h-5 w-5 sm:h-6 sm:w-6" viewBox="0 0 24 24" fill="currentColor"><path d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433a2.062 2.062 0 01-2.063-2.065 2.064 2.064 0 112.063 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z"/></svg>
            )}
            {social.icon === "fa6-brands:x-twitter" && (
              <svg class="h-5 w-5 sm:h-6 sm:w-6" viewBox="0 0 24 24" fill="currentColor"><path d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-5.214-6.817L4.99 21.75H1.68l7.73-8.835L1.254 2.25H8.08l4.713 6.231zm-1.161 17.52h1.833L7.084 4.126H5.117z"/></svg>
            )}
          </span>
          <span class="text-[10px] sm:text-xs text-white/40 truncate w-full text-center">
            @{social.label === "X" ? "themehedihq" : "themehedihq"}
          </span>
        </a>
      ))}

      <!-- Email card -->
      <a
        href="mailto:hello@mehedi-hasan.me"
        class="bento-animate flex flex-col items-center justify-center gap-2 rounded-2xl border border-white/[0.08] bg-[#161616] p-3 sm:p-4 transition-colors hover:border-[#C8FF00]/40 hover:bg-[#C8FF00]/5"
        style="transition-delay: 0.37s"
      >
        <svg class="h-5 w-5 sm:h-6 sm:w-6 text-white/60" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect width="20" height="16" x="2" y="4" rx="2"/><path d="m22 7-8.97 5.7a1.94 1.94 0 0 1-2.06 0L2 7"/></svg>
        <span class="text-[10px] sm:text-xs text-white/40">Say Hello</span>
      </a>

      <!-- WhatsApp card -->
      <a
        href="https://wa.me/8801747874773"
        target="_blank"
        rel="noopener noreferrer"
        class="bento-animate flex flex-col items-center justify-center gap-2 rounded-2xl border border-white/[0.08] bg-[#161616] p-3 sm:p-4 transition-colors hover:border-[#C8FF00]/40 hover:bg-[#C8FF00]/5"
        style="transition-delay: 0.40s"
      >
        <svg class="h-5 w-5 sm:h-6 sm:w-6 text-white/60" viewBox="0 0 24 24" fill="currentColor"><path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z"/></svg>
        <span class="text-[10px] sm:text-xs text-white/40">WhatsApp</span>
      </a>
    </div>

  </div>
</section>

<style>
  .bento-animate {
    opacity: 0;
    transform: translateY(16px);
    transition:
      opacity 0.5s ease,
      transform 0.5s ease;
  }

  [data-bento-section].is-visible .bento-animate {
    opacity: 1;
    transform: translateY(0);
    transition-delay: var(--animation-delay, 0s);
  }

  @media (prefers-reduced-motion: reduce) {
    .bento-animate {
      opacity: 1 !important;
      transform: none !important;
      transition: none !important;
    }
  }
</style>

<script>
  const section = document.querySelector<HTMLElement>("[data-bento-section]");

  if (section) {
    const animatedElements = section.querySelectorAll<HTMLElement>(".bento-animate");

    animatedElements.forEach((element) => {
      const delay = element.dataset.delay;
      if (delay) element.style.setProperty("--animation-delay", delay);
    });

    const observer = new IntersectionObserver(
      ([entry]) => {
        if (!entry?.isIntersecting) return;
        section.classList.add("is-visible");
        observer.disconnect();
      },
      { threshold: 0.05 }
    );

    observer.observe(section);
  }
</script>
