---
import { personalInfo } from "@/data/personalInfo";
import { socials } from "@/data/socials";
import { experiences } from "@/data/experience";
import { skills } from "@/data/skills";
import { educations } from "@/data/education";

import DhakaTimeCard from "@/components/live-signals/DhakaTimeCard.astro";
import LocationCard from "@/components/live-signals/LocationCard.astro";
import LastFmCard from "@/components/live-signals/LastFmCard.astro";
import HeroCTA from "@/components/ui/HeroCTA.astro";
import BentoCard from "./BentoCard.astro";

const socialPreviewMap: Record<string, string> = {
  LinkedIn: "/images/linkedin.webp",
  GitHub: "/images/github.webp",
  X: "/images/x.webp",
};

const connectItems = [
  {
    label: "hello@mehedi-hasan.me",
    href: "mailto:hello@mehedi-hasan.me",
  },
  ...socials.map((s) => ({
    ...s,
    ...(socialPreviewMap[s.label]
      ? { previewImage: socialPreviewMap[s.label] }
      : {}),
  })),
  {
    label: "Resume",
    href: personalInfo.resume,
  },
];

const recentExperience = experiences.slice(0, 3);
---

<section
  id="home"
  data-bento-section
  aria-labelledby="hero-title"
  class="flex items-center justify-center px-3 py-6 sm:px-6 sm:py-10 lg:px-16 lg:py-12"
>
  <div class="w-full max-w-[1200px]">

    <!-- BENTO HERO GRID -->
    <div
      class="bento-grid grid grid-cols-1 gap-3 sm:grid-cols-2 sm:gap-4 lg:grid-cols-4"
      style="grid-auto-rows: minmax(120px, auto);"
    >

      <!-- ═══════════════════ IDENTITY ═══════════════════ -->

      <!-- About -->
      <BentoCard
        variant="dark"
        padding="lg"
        class="bento-animate sm:col-span-2 lg:col-span-3"
        data-delay="0s"
      >
        <div class="flex h-full flex-col justify-between">
          <span
            class="mb-3 text-xs font-mono font-bold tracking-widest text-[var(--color-muted-text)] sm:mb-4"
          >
            INTRO
          </span>

          <div class="mt-2 sm:mt-4">
            <p
              id="hero-title"
              class="text-sm leading-6 text-[var(--color-secondary-text)] sm:text-base sm:leading-7"
            >
              {personalInfo.bio}
            </p>
          </div>

          <div class="mt-5 sm:mt-6">
            <HeroCTA items={connectItems} />
          </div>
        </div>
      </BentoCard>

      <!-- Profile -->
      <BentoCard
        variant="dark"
        padding="md"
        class="bento-animate flex flex-col items-center justify-center gap-3 sm:col-span-2 sm:gap-4 lg:col-span-1"
        data-delay="0.05s"
      >
        <div
          class="relative flex h-24 w-24 items-center justify-center overflow-hidden rounded-full border-2 border-[#60A5FA]/40 bg-[#60A5FA]/10 sm:h-28 sm:w-28 lg:h-32 lg:w-32"
        >
          <img
            src={personalInfo.profile}
            alt="Mehedi Hasan"
            width={2500}
            height={2500}
            loading="eager"
            fetchpriority="high"
            class="h-full w-full object-cover"
          />
        </div>

        <div class="flex items-center gap-2">
          <span class="relative flex h-2.5 w-2.5 shrink-0">
            <span
              class="absolute inline-flex h-full w-full animate-ping rounded-full opacity-75 motion-reduce:hidden"
              style="background-color: #60A5FA;"
            ></span>

            <span
              class="relative inline-flex h-2.5 w-2.5 rounded-full"
              style="background-color: #60A5FA;"
            ></span>
          </span>

          <span
            class="text-xs font-medium uppercase tracking-wide text-[var(--color-muted-text)]"
          >
            Available
          </span>
        </div>
      </BentoCard>

      <!-- ═══════════════════ EXPERIENCE ═══════════════════ -->

      <!-- Stack -->
      <BentoCard
        variant="dark"
        padding="md"
        class="bento-animate flex flex-col sm:col-span-1 lg:col-span-1"
        data-delay="0.1s"
      >
        <span
          class="mb-4 text-xs font-mono font-bold tracking-widest text-[var(--color-muted-text)]"
        >
          STACK
        </span>

        <div class="grid flex-1 grid-cols-3 gap-2.5 sm:gap-3">
          {
            skills.map((skill) => (
              <div class="flex min-w-0 flex-col items-center gap-1.5">
                <img
                  src={`/tech/${skill.icon || "default.svg"}`}
                  alt={skill.name}
                  width="28"
                  height="28"
                  loading="lazy"
                  class="h-7 w-7 object-contain"
                />

                <span class="w-full truncate text-center text-[8px] text-[var(--color-muted-text)]">
                  {skill.name}
                </span>
              </div>
            ))
          }
        </div>
      </BentoCard>

      <!-- Experience -->
      <BentoCard
        variant="dark"
        padding="lg"
        class="bento-animate sm:col-span-1 lg:col-span-2"
        data-delay="0.15s"
      >
        <div class="flex h-full flex-col">
          <span
            class="mb-4 text-xs font-mono font-bold tracking-widest text-[var(--color-muted-text)] sm:mb-5"
          >
            EXPERIENCE
          </span>

          <div
            class="flex-1 divide-y divide-[var(--color-border)]"
          >
            {
              recentExperience.map((exp) => (
                <div class="flex items-start justify-between gap-3 py-3.5 first:pt-0 last:pb-0">
                  <div class="min-w-0">
                    <h4 class="text-sm font-semibold text-[var(--color-primary-text)]">
                      {exp.role}
                    </h4>

                    <p class="mt-0.5 text-xs text-[var(--color-muted-text)]">
                      {exp.company}
                    </p>
                  </div>

                  <span class="ml-auto whitespace-nowrap text-right text-xs text-[var(--color-muted-text)]">
                    {exp.period}
                  </span>
                </div>
              ))
            }
          </div>
        </div>
      </BentoCard>

      <!-- Education -->
      {
        educations.map((edu) => (
          <BentoCard
            variant="dark"
            padding="md"
            class="bento-animate flex flex-col sm:col-span-2 lg:col-span-1"
            data-delay="0.2s"
          >
            <span
              class="mb-3 text-xs font-mono font-bold tracking-widest text-[var(--color-muted-text)]"
            >
              EDUCATION
            </span>

            <h3 class="text-sm font-semibold leading-snug text-[var(--color-primary-text)]">
              {edu.degree}
            </h3>

            <p class="mt-1 text-xs text-[var(--color-muted-text)]">
              {edu.institution}
            </p>

            <p class="mt-1.5 text-[10px] text-[var(--color-muted-text)]">
              {edu.period}
            </p>

            <div class="mt-3 flex flex-wrap gap-1">
              {
                edu.subjects?.map((subject) => (
                  <span class="rounded-full bg-[var(--color-hover)] px-2 py-0.5 text-[9px] text-[var(--color-muted-text)]">
                    {subject}
                  </span>
                ))
              }
            </div>
          </BentoCard>
        ))
      }

      <!-- ═══════════════════ SELECTED WORK ═══════════════════ -->

      <!-- Projects -->
      <div
        class="col-span-full grid grid-cols-1 gap-3 sm:grid-cols-2 sm:gap-4 lg:grid-cols-3"
        data-delay="0.2s"
      >

        <!-- AY Voice -->
        <BentoCard
          variant="image"
          padding="md"
          class="bento-animate group min-h-[220px] sm:min-h-[260px] lg:min-h-[280px]"
          data-delay="0.2s"
        >
          <a
            href="https://ayvoice.com"
            target="_blank"
            rel="noopener noreferrer"
            class="relative block h-full w-full"
          >
            <div
              class="absolute inset-0 overflow-hidden rounded-xl border border-[var(--color-border)]"
            >
              <img
                src="/projects/ayvoice.webp"
                alt="AY Voice"
                width={1600}
                height={1000}
                loading="eager"
                class="h-full w-full object-cover transition-transform duration-500 group-hover:scale-105"
              />

              <div
                class="absolute inset-0 bg-gradient-to-t from-black/80 via-black/20 to-transparent"
              ></div>
            </div>

            <div class="relative flex h-full flex-col justify-end">
              <div class="mb-1">
                <span
                  class="text-[10px] font-mono font-bold tracking-widest text-white/80"
                >
                  FEATURED PROJECT
                </span>
              </div>

              <h3 class="text-lg font-semibold text-white sm:text-xl">
                AY Voice
              </h3>

              <p class="mt-1 line-clamp-2 text-xs text-white/60">
                Cloud-based bulk SMS & voice calling platform
              </p>
            </div>
          </a>
        </BentoCard>

        <!-- NexVibe -->
        <BentoCard
          variant="image"
          padding="md"
          class="bento-animate group min-h-[220px] sm:min-h-[260px] lg:min-h-[280px]"
          data-delay="0.25s"
        >
          <a
            href="https://nexvibe.tech"
            target="_blank"
            rel="noopener noreferrer"
            class="relative block h-full w-full"
          >
            <div
              class="absolute inset-0 overflow-hidden rounded-xl border border-[var(--color-border)]"
            >
              <img
                src="/projects/nexvibe.webp"
                alt="NexVibe"
                width={1600}
                height={1000}
                loading="lazy"
                class="h-full w-full object-cover transition-transform duration-500 group-hover:scale-105"
              />

              <div
                class="absolute inset-0 bg-gradient-to-t from-black/80 via-black/20 to-transparent"
              ></div>
            </div>

            <div class="relative flex h-full flex-col justify-end">
              <div class="mb-1">
                <span
                  class="text-[10px] font-mono font-bold tracking-widest text-white/80"
                >
                  FEATURED PROJECT
                </span>
              </div>

              <h3 class="text-lg font-semibold text-white sm:text-xl">
                NexVibe
              </h3>

              <p class="mt-1 text-xs text-white/60">
                Software agency website
              </p>
            </div>
          </a>
        </BentoCard>

        <!-- Kashly -->
        <BentoCard
          variant="image"
          padding="md"
          class="bento-animate group min-h-[220px] sm:min-h-[260px] lg:min-h-[280px]"
          data-delay="0.3s"
        >
          <a
            href="https://kashly.mehedi-hasan.me"
            target="_blank"
            rel="noopener noreferrer"
            class="relative block h-full w-full"
          >
            <div
              class="absolute inset-0 overflow-hidden rounded-xl border border-[var(--color-border)]"
            >
              <img
                src="/projects/kashly.webp"
                alt="Kashly"
                width={1600}
                height={1000}
                loading="lazy"
                class="h-full w-full object-cover transition-transform duration-500 group-hover:scale-105"
              />

              <div
                class="absolute inset-0 bg-gradient-to-t from-black/80 via-black/20 to-transparent"
              ></div>
            </div>

            <div class="relative flex h-full flex-col justify-end">
              <div class="mb-1">
                <span
                  class="text-[10px] font-mono font-bold tracking-widest text-white/80"
                >
                  FEATURED PROJECT
                </span>
              </div>

              <h3 class="text-lg font-semibold text-white sm:text-xl">
                Kashly
              </h3>

              <p class="mt-1 text-xs text-white/60">
                Money management app
              </p>
            </div>
          </a>
        </BentoCard>

      </div>

      <!-- ═══════════════════ PROOF ═══════════════════ -->

      <!-- GitHub -->
      <BentoCard
        variant="dark"
        padding="md"
        class="bento-animate sm:col-span-2 lg:col-span-3"
        data-delay="0.35s"
      >
        <div class="flex flex-col">
          <span
            class="mb-3 text-xs font-mono font-bold tracking-widest text-[var(--color-muted-text)]"
          >
            GITHUB
          </span>

          <div class="-mx-1 overflow-x-auto">
            <img
              src="https://ghchart.rshah.org/themehedihq"
              alt="Mehedi Hasan's GitHub Contribution Graph"
              class="h-auto min-w-[280px] w-full rounded-lg opacity-80"
              loading="lazy"
            />
          </div>
        </div>
      </BentoCard>

      <!-- Blog -->
      <BentoCard
        variant="dark"
        padding="md"
        class="bento-animate group sm:col-span-2 lg:col-span-1"
        data-delay="0.4s"
      >
        <a
          href="/blog"
          class="flex h-full flex-col items-center justify-center gap-2 text-center"
        >
          <span
            class="text-xs font-mono font-bold tracking-widest text-[var(--color-muted-text)]"
          >
            BLOG
          </span>

          <h3
            class="text-sm font-semibold text-[var(--color-primary-text)] transition-colors group-hover:text-[var(--color-accent)]"
          >
            Read my thoughts
          </h3>

          <div
            class="flex items-center gap-1 text-xs text-[var(--color-muted-text)] transition-colors group-hover:text-[var(--color-accent)]"
          >
            <span>View posts</span>

            <svg
              class="h-3 w-3 transition-transform group-hover:translate-x-1"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              stroke-linecap="round"
              stroke-linejoin="round"
            >
              <line x1="5" y1="12" x2="19" y2="12"></line>
              <polyline points="12 5 19 12 12 19"></polyline>
            </svg>
          </div>
        </a>
      </BentoCard>

      <!-- ═══════════════════ LIVE SIGNALS + CONTACT ═══════════════════ -->

      <div
        class="col-span-full grid grid-cols-1 gap-3 sm:grid-cols-2 sm:gap-4 lg:grid-cols-4"
        data-delay="0.5s"
      >

        <!-- Dhaka Time -->
        <BentoCard
          variant="dark"
          padding="md"
          class="bento-animate"
          data-delay="0.5s"
        >
          <DhakaTimeCard />
        </BentoCard>

        <!-- Location -->
        <BentoCard
          variant="dark"
          padding="md"
          class="bento-animate"
          data-delay="0.55s"
        >
          <LocationCard />
        </BentoCard>

        <!-- Last.fm -->
        <BentoCard
          variant="dark"
          padding="md"
          class="bento-animate"
          data-delay="0.6s"
        >
          <LastFmCard />
        </BentoCard>

        <!-- Contact -->
        <BentoCard
          variant="dark"
          padding="md"
          class="bento-animate group"
          data-delay="0.65s"
        >
          <a
            href="/contact"
            class="flex h-full min-h-[120px] flex-col items-center justify-center gap-2 text-center"
          >
            <span
              class="text-xs font-mono font-bold tracking-widest text-[var(--color-muted-text)]"
            >
              HIRE ME
            </span>

            <h3
              class="text-sm font-semibold text-[var(--color-primary-text)] transition-colors group-hover:text-[var(--color-accent)]"
            >
              Let's work together
            </h3>

            <div
              class="flex items-center gap-1 text-xs text-[var(--color-muted-text)] transition-colors group-hover:text-[var(--color-accent)]"
            >
              <span>Get in touch</span>

              <svg
                class="h-3 w-3 transition-transform group-hover:translate-x-1"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="2"
                stroke-linecap="round"
                stroke-linejoin="round"
              >
                <line x1="5" y1="12" x2="19" y2="12"></line>
                <polyline points="12 5 19 12 12 19"></polyline>
              </svg>
            </div>
          </a>
        </BentoCard>

      </div>

      <!-- ═══════════════════ SOCIAL LINKS ═══════════════════ -->

      <div
        class="col-span-full grid grid-cols-2 gap-3 sm:grid-cols-3 sm:gap-4 lg:grid-cols-5"
        data-delay="0.7s"
      >

        <!-- GitHub -->
        <a
          href="https://github.com/themehedihq"
          target="_blank"
          rel="noopener noreferrer"
          class="bento-animate flex min-h-[90px] flex-col items-center justify-center gap-2 rounded-2xl border border-[var(--color-border)] bg-[var(--color-surface)] p-4 transition-colors hover:border-[var(--color-accent)]/40 hover:bg-[var(--color-accent)]/5 lg:rounded-3xl"
          data-delay="0.7s"
        >
          <svg
            class="h-6 w-6 text-[var(--color-muted-text)]"
            viewBox="0 0 24 24"
            fill="currentColor"
          >
            <path
              d="M12 0c-6.626 0-12 5.373-12 12 0 5.302 3.438 9.8 8.207 11.387.599.111.793-.261.793-.577v-2.234c-3.338.726-4.033-1.416-4.033-1.416-.546-1.387-1.333-1.756-1.333-1.756-1.089-.745.083-.729.083-.729 1.205.084 1.839 1.237 1.839 1.237 1.07 1.834 2.807 1.304 3.492.997.107-.775.418-1.305.762-1.604-2.665-.305-5.467-1.334-5.467-5.931 0-1.311.469-2.381 1.236-3.221-.124-.303-.535-1.524.117-3.176 0 0 1.008-.322 3.301 1.23.957-.266 1.983-.399 3.003-.404 1.02.005 2.047.138 3.006.404 2.291-1.552 3.297-1.23 3.297-1.23.653 1.653.242 2.874.118 3.176.77.84 1.235 1.911 1.235 3.221 0 4.609-2.807 5.624-5.479 5.921.43.372.823 1.102.823 2.222v3.293c0 .319.192.694.801.576 4.765-1.589 8.199-6.086 8.199-11.386 0-6.627-5.373-12-12-12z"
            ></path>
          </svg>

          <span class="text-xs text-[var(--color-muted-text)]">
            GitHub
          </span>
        </a>

        <!-- LinkedIn -->
        <a
          href="https://linkedin.com/in/themehedihq"
          target="_blank"
          rel="noopener noreferrer"
          class="bento-animate flex min-h-[90px] flex-col items-center justify-center gap-2 rounded-2xl border border-[var(--color-border)] bg-[var(--color-surface)] p-4 transition-colors hover:border-[var(--color-accent)]/40 hover:bg-[var(--color-accent)]/5 lg:rounded-3xl"
          data-delay="0.75s"
        >
          <svg
            class="h-6 w-6 text-[var(--color-muted-text)]"
            viewBox="0 0 24 24"
            fill="currentColor"
          >
            <path
              d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433a2.062 2.062 0 01-2.063-2.065 2.064 2.064 0 112.063 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2.227 22.222 0h.003z"
            ></path>
          </svg>

          <span class="text-xs text-[var(--color-muted-text)]">
            LinkedIn
          </span>
        </a>

        <!-- X -->
        <a
          href="https://x.com/themehedihq"
          target="_blank"
          rel="noopener noreferrer"
          class="bento-animate flex min-h-[90px] flex-col items-center justify-center gap-2 rounded-2xl border border-[var(--color-border)] bg-[var(--color-surface)] p-4 transition-colors hover:border-[var(--color-accent)]/40 hover:bg-[var(--color-accent)]/5 lg:rounded-3xl"
          data-delay="0.8s"
        >
          <svg
            class="h-6 w-6 text-[var(--color-muted-text)]"
            viewBox="0 0 24 24"
            fill="currentColor"
          >
            <path
              d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-5.214-6.817L4.99 21.75H1.68l7.73-8.835L1.254 2.25H8.08l4.713 6.231zm-1.161 17.52h1.833L7.084 4.126H5.117z"
            ></path>
          </svg>

          <span class="text-xs text-[var(--color-muted-text)]">
            X
          </span>
        </a>

        <!-- Email -->
        <a
          href="mailto:hello@mehedi-hasan.me"
          class="bento-animate flex min-h-[90px] flex-col items-center justify-center gap-2 rounded-2xl border border-[var(--color-border)] bg-[var(--color-surface)] p-4 transition-colors hover:border-[var(--color-accent)]/40 hover:bg-[var(--color-accent)]/5 lg:rounded-3xl"
          data-delay="0.85s"
        >
          <svg
            class="h-6 w-6 text-[var(--color-muted-text)]"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            stroke-linejoin="round"
          >
            <rect width="20" height="16" x="2" y="4" rx="2"></rect>
            <path
              d="m22 7-8.97 5.7a1.94 1.94 0 0 1-2.06 0L2 7"
            ></path>
          </svg>

          <span class="text-xs text-[var(--color-muted-text)]">
            Email
          </span>
        </a>

        <!-- Calendly -->
        <a
          href="https://calendly.com/themehedihq"
          target="_blank"
          rel="noopener noreferrer"
          class="bento-animate flex min-h-[90px] flex-col items-center justify-center gap-2 rounded-2xl border border-[var(--color-border)] bg-[var(--color-surface)] p-4 transition-colors hover:border-[var(--color-accent)]/40 hover:bg-[var(--color-accent)]/5 lg:rounded-3xl"
          data-delay="0.9s"
        >
          <svg
            class="h-6 w-6 text-[var(--color-muted-text)]"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            stroke-linejoin="round"
          >
            <rect width="18" height="18" x="3" y="4" rx="2" ry="2"></rect>
            <line x1="16" x2="16" y1="2" y2="6"></line>
            <line x1="8" x2="8" y1="2" y2="6"></line>
            <line x1="3" x2="21" y1="10" y2="10"></line>
            <path d="M8 14h.01"></path>
            <path d="M12 14h.01"></path>
            <path d="M16 14h.01"></path>
            <path d="M8 18h.01"></path>
            <path d="M12 18h.01"></path>
            <path d="M16 18h.01"></path>
          </svg>

          <span class="text-xs text-[var(--color-muted-text)]">
            Calendly
          </span>
        </a>

      </div>

    </div>
  </div>
</section>

<style>
  .bento-animate {
    opacity: 0;
    transform: translateY(16px);
    transition:
      opacity 0.5s ease,
      transform 0.5s ease;
  }

  [data-bento-section].is-visible .bento-animate {
    opacity: 1;
    transform: translateY(0);
    transition-delay: var(--animation-delay, 0s);
  }

  @media (prefers-reduced-motion: reduce) {
    .bento-animate {
      opacity: 1 !important;
      transform: none !important;
      transition: none !important;
    }
  }
</style>

<script>
  const section =
    document.querySelector<HTMLElement>("[data-bento-section]");

  if (section) {
    const animatedElements =
      section.querySelectorAll<HTMLElement>(".bento-animate");

    animatedElements.forEach((element) => {
      const delay = element.dataset.delay;

      if (delay) {
        element.style.setProperty("--animation-delay", delay);
      }
    });

    const observer = new IntersectionObserver(
      ([entry]) => {
        if (!entry?.isIntersecting) return;

        section.classList.add("is-visible");
        observer.disconnect();
      },
      {
        threshold: 0.05,
      }
    );

    observer.observe(section);
  }
</script>