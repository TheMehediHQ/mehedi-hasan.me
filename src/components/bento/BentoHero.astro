---
import { personalInfo } from "@/data/personalInfo";
import { socials } from "@/data/socials";
import { experiences } from "@/data/experience";
import { skills } from "@/data/skills";
import { educations } from "@/data/education";
import { Icon } from "astro-icon/components";

import DhakaTimeCard from "@/components/live-signals/DhakaTimeCard.astro";
import LocationCard from "@/components/live-signals/LocationCard.astro";
import LastFmCard from "@/components/live-signals/LastFmCard.astro";
import HeroCTA from "@/components/ui/HeroCTA.astro";
import BentoCard from "./BentoCard.astro";

const socialPreviewMap: Record<string, string> = {
  LinkedIn: "/images/linkedin.webp",
  GitHub: "/images/github.webp",
  X: "/images/x.webp",
};

const connectItems = [
  {
    label: "hello@mehedi-hasan.me",
    href: "mailto:hello@mehedi-hasan.me",
  },
  ...socials.map((s) => ({
    ...s,
    ...(socialPreviewMap[s.label]
      ? { previewImage: socialPreviewMap[s.label] }
      : {}),
  })),
  {
    label: "Resume",
    href: personalInfo.resume,
  },
];

const recentExperience = experiences.slice(0, 3);

const iconMap: Record<string, string> = {
  React: "simple-icons:react",
  "Next.js": "simple-icons:nextdotjs",
  TypeScript: "simple-icons:typescript",
  JavaScript: "simple-icons:javascript",
  "Node.js": "simple-icons:nodedotjs",
  Python: "simple-icons:python",
  OpenAI: "simple-icons:openai",
  FastAPI: "simple-icons:fastapi",
  PostgreSQL: "simple-icons:postgresql",
  MongoDB: "simple-icons:mongodb",
  Docker: "simple-icons:docker",
  AWS: "simple-icons:amazonaws",
  Git: "simple-icons:git",
  Linux: "simple-icons:linux",
};

const projects = [
  {
    name: "AY Voice",
    href: "https://ayvoice.com",
    video: "/projects/ayvoice.webm",
    year: "2026",
  },
  {
    name: "NexVibe",
    href: "https://nexvibe.tech",
    video: "/projects/mexvibe.webm",
    year: "2025",
  },
  {
    name: "Kashly",
    href: "https://kashly.mehedi-hasan.me",
    video: "/projects/kashly.webm",
    year: "2024",
  },
];

const socialLinks = [
  { icon: "fa6-brands:github", href: "https://github.com/themehedihq", label: "GitHub" },
  { icon: "fa6-brands:linkedin", href: "https://linkedin.com/in/themehedihq", label: "LinkedIn" },
  { icon: "fa6-brands:x-twitter", href: "https://x.com/themehedihq", label: "X" },
  { icon: "lucide:mail", href: "mailto:hello@mehedi-hasan.me", label: "Email" },
  { icon: "lucide:calendar", href: "https://calendly.com/themehedihq", label: "Calendly" },
];
---

<section
  id="home"
  data-bento-section
  aria-labelledby="hero-title"
  class="flex items-center justify-center px-3 py-6 sm:px-6 sm:py-10 lg:px-16 lg:py-12"
>
  <div class="w-full max-w-[1200px]">

    <!-- BENTO HERO GRID -->
    <div
      class="bento-grid grid grid-cols-1 gap-3 sm:grid-cols-2 sm:gap-4 lg:grid-cols-4"
      style="grid-auto-rows: minmax(120px, auto);"
    >

      <!-- ═══════════════════ IDENTITY ═══════════════════ -->

      <!-- About -->
      <BentoCard
        variant="dark"
        padding="lg"
        class="bento-animate sm:col-span-2 lg:col-span-3"
        data-delay="0s"
      >
        <div class="flex h-full flex-col justify-between">
          <div>
            <div class="flex items-center gap-3">
              <img
                src={personalInfo.profile}
                alt="Mehedi Hasan"
                width={48}
                height={48}
                class="h-10 w-10 rounded-full object-cover ring-2 ring-[var(--color-accent)]/30"
              />
              <div>
                <h2 class="text-xl font-bold text-[var(--color-primary-text)] sm:text-2xl">
                  Hey, I'm Mehedi Hasan
                </h2>
                <p class="mt-0.5 text-sm text-[var(--color-muted-text)] sm:text-base">
                  AI/LLM Developer & Full Stack Developer
                </p>
              </div>
            </div>
          </div>

          <div class="mt-4 sm:mt-6">
            <p
              id="hero-title"
              class="text-sm leading-6 text-[var(--color-secondary-text)] sm:text-base sm:leading-7"
            >
              {personalInfo.bio}
            </p>
          </div>

          <div class="mt-5 sm:mt-6">
            <HeroCTA items={connectItems} />
          </div>
        </div>
      </BentoCard>

   
    

      <!-- ═══════════════════ EXPERIENCE ═══════════════════ -->

      <!-- Stack -->
      <BentoCard
        variant="dark"
        padding="md"
        class="bento-animate flex flex-col sm:col-span-1 lg:col-span-1"
        data-delay="0.1s"
      >
        <h3 class="mb-3 text-sm font-semibold text-[var(--color-primary-text)] sm:mb-4">
          Tools I use
        </h3>

        <div class="flex flex-1 flex-wrap gap-2">
          {
            skills.map((skill) => (
              <span
                class="inline-flex items-center gap-1.5 rounded-full bg-[var(--color-hover)] px-3 py-1.5 text-xs font-medium text-[var(--color-secondary-text)]"
              >
                {iconMap[skill.name] && (
                  <Icon name={iconMap[skill.name]} class="h-3.5 w-3.5" />
                )}
                {skill.name}
              </span>
            ))
          }
        </div>
      </BentoCard>

      <!-- Experience -->
      <BentoCard
        variant="dark"
        padding="lg"
        class="bento-animate sm:col-span-1 lg:col-span-3"
        data-delay="0.15s"
      >
        <div class="flex h-full flex-col">
          <h3 class="mb-4 text-sm font-semibold text-[var(--color-primary-text)] sm:mb-5">
            Experience
          </h3>

          <div
            class="flex-1 divide-y divide-[var(--color-border)]"
          >
            {
              recentExperience.map((exp) => (
                <div class="flex items-start justify-between gap-3 py-3.5 first:pt-0 last:pb-0">
                  <div class="min-w-0">
                    <h4 class="text-sm font-semibold text-[var(--color-primary-text)]">
                      {exp.role}
                    </h4>

                    <p class="mt-0.5 text-xs text-[var(--color-muted-text)]">
                      {exp.company}
                    </p>
                  </div>

                  <span class="ml-auto whitespace-nowrap text-right text-xs text-[var(--color-muted-text)]">
                    {exp.period}
                  </span>
                </div>
              ))
            }
          </div>
        </div>
      </BentoCard>

      <!-- Education -->
      {
        educations.map((edu) => (
          <BentoCard
            variant="dark"
            padding="md"
            class="bento-animate flex flex-col sm:col-span-2 lg:col-span-1"
            data-delay="0.2s"
          >
            <h3 class="mb-3 text-sm font-semibold text-[var(--color-primary-text)]">
              Education
            </h3>

            <h4 class="text-sm font-semibold leading-snug text-[var(--color-primary-text)]">
              {edu.degree}
            </h4>

            <p class="mt-1 text-xs text-[var(--color-muted-text)]">
              {edu.institution}
            </p>

            <p class="mt-1.5 text-xs text-[var(--color-muted-text)]">
              {edu.period}
            </p>

            <div class="mt-3 flex flex-wrap gap-1">
              {
                edu.subjects?.map((subject) => (
                  <span class="rounded-full bg-[var(--color-hover)] px-2 py-0.5 text-[11px] text-[var(--color-muted-text)]">
                    {subject}
                  </span>
                ))
              }
            </div>
          </BentoCard>
        ))
      }

      <!-- ═══════════════════ SELECTED WORK ═══════════════════ -->

      <!-- Projects -->

      <div
        class="col-span-full grid grid-cols-1 gap-3 sm:grid-cols-2 sm:gap-4 lg:grid-cols-3"
      >
        {
          projects.map((project, i) => (
            <BentoCard
              variant="image"
              padding="none"
              class="bento-animate group min-h-[220px] sm:min-h-[260px] lg:min-h-[280px]"
              data-delay={`${0.2 + i * 0.05}s`}
            >
              <a
                href={project.href}
                target="_blank"
                rel="noopener noreferrer"
                class="relative block h-full w-full"
              >
                <div class="absolute inset-0 overflow-hidden rounded-xl border border-[var(--color-border)]">
                  <video
                    src={project.video}
                    autoplay
                    loop
                    muted
                    playsinline
                    class="h-full w-full object-cover transition-transform duration-500 group-hover:scale-105"
                  />
                  <div class="absolute inset-0 bg-gradient-to-t from-black/80 via-black/20 to-transparent" />
                </div>

                <div class="relative flex h-full items-end justify-between px-4 pb-4">
                  <div class="flex items-center gap-1.5">
                    <h3 class="text-base font-semibold text-white sm:text-lg">
                      {project.name}
                    </h3>
                    <Icon
                      name="lucide:arrow-up-right"
                      class="h-3.5 w-3.5 text-white/70 transition-transform group-hover:translate-x-0.5 group-hover:-translate-y-0.5"
                    />
                  </div>
                  <span class="text-xs text-white/50">{project.year}</span>
                </div>
              </a>
            </BentoCard>
          ))
        }
      </div>

      <!-- ═══════════════════ PROOF ═══════════════════ -->

      <!-- GitHub -->
      <BentoCard
        variant="dark"
        padding="md"
        class="bento-animate sm:col-span-2 lg:col-span-3"
        data-delay="0.35s"
      >
        <div class="flex flex-col">
          <h3 class="mb-3 text-sm font-semibold text-[var(--color-primary-text)]">
            GitHub
          </h3>

          <div class="-mx-1 overflow-x-auto">
            <img
              src="https://ghchart.rshah.org/themehedihq"
              alt="Mehedi Hasan's GitHub Contribution Graph"
              class="h-auto min-w-[280px] w-full rounded-lg opacity-80"
              loading="lazy"
            />
          </div>
        </div>
      </BentoCard>

      <!-- Blog -->
      <BentoCard
        variant="dark"
        padding="md"
        class="bento-animate group sm:col-span-2 lg:col-span-1"
        data-delay="0.4s"
      >
        <a
          href="/blog"
          class="flex h-full flex-col justify-between"
        >
          <div>
            <h3
              class="text-lg font-bold text-[var(--color-primary-text)]"
            >
              Blog
            </h3>
            <p class="mt-1 text-xs text-[var(--color-muted-text)]">
              Writing code and sharing the journey.
            </p>
          </div>

          <div
            class="mt-4 inline-flex w-fit items-center gap-2 rounded-full border border-[var(--color-border)] px-4 py-2 text-xs font-medium text-[var(--color-primary-text)] transition-colors group-hover:border-[var(--color-accent)]/40 group-hover:text-[var(--color-accent)]"
          >
            <span>View posts</span>
            <Icon
              name="lucide:arrow-up-right"
              class="h-3.5 w-3.5 transition-transform group-hover:translate-x-0.5"
            />
          </div>
        </a>
      </BentoCard>

      <!-- ═══════════════════ LIVE SIGNALS + CONTACT ═══════════════════ -->

      <div
        class="col-span-full grid grid-cols-1 gap-3 sm:grid-cols-2 sm:gap-4 lg:grid-cols-4"
        data-delay="0.5s"
      >

        <!-- Dhaka Time -->
        <BentoCard
          variant="dark"
          padding="none"
          class="bento-animate"
          data-delay="0.5s"
        >
          <DhakaTimeCard />
        </BentoCard>

        <!-- Location -->
        <BentoCard
          variant="dark"
          padding="none"
          class="bento-animate"
          data-delay="0.55s"
        >
          <LocationCard />
        </BentoCard>

        <!-- Last.fm -->
        <BentoCard
          variant="dark"
          padding="none"
          class="bento-animate"
          data-delay="0.6s"
        >
          <LastFmCard />
        </BentoCard>

        <!-- Contact -->
        <BentoCard
          variant="dark"
          padding="md"
          class="bento-animate group"
          data-delay="0.65s"
        >
          <a
            href="/contact"
            class="flex h-full min-h-[120px] flex-col justify-between"
          >
            <div>
              <h3
                class="text-lg font-bold text-[var(--color-primary-text)]"
              >
                Let's collab!
              </h3>
              <p class="mt-1 text-xs text-[var(--color-muted-text)]">
                Let's turn your idea into reality with my development experience!
              </p>
            </div>

            <div
              class="mt-4 inline-flex w-fit items-center gap-2 rounded-full border border-[var(--color-border)] px-4 py-2 text-xs font-medium text-[var(--color-primary-text)] transition-colors group-hover:border-[var(--color-accent)]/40 group-hover:text-[var(--color-accent)]"
            >
              <span>Send a message now!</span>
              <Icon
                name="lucide:arrow-up-right"
                class="h-3.5 w-3.5 transition-transform group-hover:translate-x-0.5"
              />
            </div>
          </a>
        </BentoCard>

      </div>

  

    </div>
  </div>
</section>

<style>
  .bento-animate {
    opacity: 0;
    transform: translateY(16px);
    transition:
      opacity 0.5s ease,
      transform 0.5s ease;
  }

  [data-bento-section].is-visible .bento-animate {
    opacity: 1;
    transform: translateY(0);
    transition-delay: var(--animation-delay, 0s);
  }

  [data-bento-section].is-visible .bento-animate:hover {
    transform: translateY(-2px);
    transition: transform 0.3s ease-out;
    transition-delay: 0s;
  }

  @media (prefers-reduced-motion: reduce) {
    .bento-animate {
      opacity: 1 !important;
      transform: none !important;
      transition: none !important;
    }
  }
</style>

<script>
  const section =
    document.querySelector<HTMLElement>("[data-bento-section]");

  if (section) {
    const animatedElements =
      section.querySelectorAll<HTMLElement>(".bento-animate");

    animatedElements.forEach((element) => {
      const delay = element.dataset.delay;

      if (delay) {
        element.style.setProperty("--animation-delay", delay);
      }
    });

    const observer = new IntersectionObserver(
      ([entry]) => {
        if (!entry?.isIntersecting) return;

        section.classList.add("is-visible");
        observer.disconnect();
      },
      {
        threshold: 0.05,
      }
    );

    observer.observe(section);
  }
</script>