---
import { skills } from "@/data/skills";
---

<section id="stack" class="px-4 py-8 sm:px-8 sm:py-12 lg:px-16">
  <div class="mx-auto w-full max-w-[1400px]">

    <p
      class="mb-5 text-xs font-medium uppercase tracking-[0.2em] bento-fade"
      style="color: var(--color-muted-text);"
    >
      Tech Stack
    </p>

    <div class="bento-fade rounded-2xl lg:rounded-3xl border border-[var(--color-border)] bg-[var(--color-surface)] p-5 sm:p-6">
      <div class="grid grid-cols-4 gap-x-6 gap-y-8 sm:grid-cols-5 md:grid-cols-7 lg:grid-cols-7">
        {skills.map((skill) => (
          <div class="group flex flex-col items-center gap-2">
            <img
              src={`/tech/${skill.icon || "default.svg"}`}
              alt={skill.name}
              width="36"
              height="36"
              loading="lazy"
              class="object-contain transition-transform duration-200 group-hover:scale-110"
            />
            <span
              class="text-[10px] sm:text-xs font-medium opacity-0 transition-opacity duration-200 group-hover:opacity-100"
              style="color: var(--color-secondary-text);"
            >
              {skill.name}
            </span>
          </div>
        ))}
      </div>
    </div>

  </div>
</section>

<style>
  .bento-fade {
    opacity: 0;
    transform: translateY(16px);
    transition: opacity 0.45s ease, transform 0.45s ease;
  }
  .bento-fade.visible {
    opacity: 1;
    transform: translateY(0);
  }
</style>

<script>
  const section = document.getElementById("stack");
  if (section) {
    const observer = new IntersectionObserver(
      (entries) => {
        entries.forEach((entry) => {
          if (entry.isIntersecting) {
            section.querySelectorAll(".bento-fade").forEach((el) => el.classList.add("visible"));
            observer.disconnect();
          }
        });
      },
      { threshold: 0.1 }
    );
    observer.observe(section);
  }
</script>
