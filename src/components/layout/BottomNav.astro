---
import { Icon } from "astro-icon/components";
import { navItems } from "../../data/navItems";

const isHome = Astro.url.pathname === "/";

const filteredNavItems = navItems.filter(
  (item) => item.id !== "about"
);

const iconMap: Record<string, string> = {
  Home: "lucide:house",
  Briefcase: "lucide:briefcase",
  FolderOpen: "lucide:folder-open",
  Mail: "lucide:mail",
  BookOpen: "lucide:book-open",
};
---

<nav
  class="fixed bottom-0 left-0 right-0 z-50 flex w-full items-center justify-around border-t px-2 pt-2 pb-[calc(env(safe-area-inset-bottom,0px)+8px)] backdrop-blur-xl transition-all duration-300 lg:hidden"
  style="
    background-color: var(--color-background);
    border-color: var(--color-border);
  "
>
  {
    filteredNavItems.map((item) => {
      const iconName = iconMap[item.icon] ?? "lucide:circle";
      const isExternal = !!item.href;
      const isPageLink = !!item.path && !isExternal;

      if (isExternal) {
        return (
          <a
            href={item.href}
            target="_blank"
            rel="noopener noreferrer"
            class="relative flex flex-1 flex-col items-center justify-center py-1 text-[var(--color-muted-text)] transition-all duration-200 hover:text-[var(--color-primary-text)] active:scale-95"
          >
            <Icon name={iconName} size={20} />
            <span class="mt-1 text-[10px] tracking-tight">
              {item.label}
            </span>
          </a>
        );
      }

      if (isPageLink) {
        const linkHref = (!isHome && item.path.startsWith("#"))
          ? `/${item.path}`
          : item.path;
        return (
          <a
            href={linkHref}
            class="relative flex flex-1 flex-col items-center justify-center py-1 text-[var(--color-muted-text)] transition-all duration-200 hover:text-[var(--color-primary-text)] active:scale-95"
          >
            <Icon name={iconName} size={20} />
            <span class="mt-1 text-[10px] tracking-tight">
              {item.label}
            </span>
          </a>
        );
      }

      if (isHome) {
        return (
          <a
            href={`#${item.id}`}
            data-nav-section={item.id}
            class="relative flex flex-1 flex-col items-center justify-center py-1 text-[var(--color-muted-text)] transition-all duration-200 hover:text-[var(--color-primary-text)] active:scale-95"
            data-active="false"
          >
            <Icon name={iconName} size={20} />
            <span class="mt-1 text-[10px] tracking-tight">
              {item.label}
            </span>
          </a>
        );
      }

      return (
        <a
          href="/"
          class="relative flex flex-1 flex-col items-center justify-center py-1 text-[var(--color-muted-text)] transition-all duration-200 hover:text-[var(--color-primary-text)] active:scale-95"
        >
          <Icon name={iconName} size={20} />
          <span class="mt-1 text-[10px] tracking-tight">
            {item.label}
          </span>
        </a>
      );
    })
  }
</nav>

<style>
  [data-nav-section][data-active="true"] {
    color: var(--color-accent);
    font-weight: 600;
  }
</style>
