---
import ThemeToggle from "../ThemeToggle.astro";
import { personalInfo } from "@/constants/personalInfo";
---

<footer
  class="max-w-4xl mx-auto flex items-center justify-between px-6 lg:px-0 py-4"
  style="border-color: var(--color-border);"
>
  <!-- Copyright Text -->
  <p
    class="text-xs font-medium"
    style="color: var(--color-muted-text);"
  >
    © {new Date().getFullYear()} {personalInfo.name}
  </p>

  <!-- Last Visitor -->
  <div id="last-visitor" class="text-xs" style="color: var(--color-muted-text);">
    <span id="last-visitor-text"></span>
  </div>

  <!-- Theme Toggle Button -->
  <div class="flex items-center">
    <ThemeToggle />
  </div>
</footer>

<script>
  type Visitor = {
    city: string;
    country: string;
    countryCode: string;
    visitedAt: string;
  };

  let intervalId: ReturnType<typeof setInterval> | null = null;

  function countryCodeToFlag(code: string) {
    return code
      .toUpperCase()
      .split("")
      .map((char) =>
        String.fromCodePoint(char.charCodeAt(0) + 127397),
      )
      .join("");
  }

  function relativeTime(iso: string) {
    const diff = Math.floor(
      (Date.now() - new Date(iso).getTime()) / 1000,
    );

    if (diff < 60) return "just now";

    const minutes = Math.floor(diff / 60);

    if (minutes < 60) return `${minutes} min ago`;

    const hours = Math.floor(minutes / 60);

    if (hours < 24) return `${hours}h ago`;

    return `${Math.floor(hours / 24)}d ago`;
  }

  async function loadVisitor() {
    const textEl = document.getElementById("last-visitor-text");

    if (!textEl) return;

    try {
      const response = await fetch("/api/visitor", {
        cache: "no-store",
      });

      if (!response.ok) return;

      const data: { visitor: Visitor | null } =
        await response.json();

      if (!data.visitor) return;

      const visitor = data.visitor;

      const render = () => {
        textEl.textContent =
          `${countryCodeToFlag(visitor.countryCode)} ${visitor.city}, ${visitor.country} · ${relativeTime(visitor.visitedAt)}`;
      };

      render();

      if (intervalId) {
        clearInterval(intervalId);
      }

      intervalId = setInterval(render, 45_000);
    } catch (error) {
      console.error("Visitor loading failed:", error);
    }
  }

  loadVisitor();

  document.addEventListener("astro:page-load", loadVisitor);

  document.addEventListener("astro:before-swap", () => {
    if (intervalId) {
      clearInterval(intervalId);
      intervalId = null;
    }
  });
</script>