---
import { Icon } from "astro-icon/components";

import { navItems } from "../../data/navItems";
import { personalInfo } from "../../data/personalInfo";
import { socials } from "../../data/socials";


const isHome = Astro.url.pathname === "/";

const iconMap: Record<string, string> = {
  Home: "lucide:house",
  User: "lucide:user",
  Briefcase: "lucide:briefcase",
  FolderOpen: "lucide:folder-open",
  Code: "lucide:code-2",
  Mail: "lucide:mail",
  Download: "lucide:download",
  BookOpen: "lucide:book-open",
};
---

<aside
  class="fixed left-0 top-0 z-50 hidden h-screen w-[200px] flex-col transition-all duration-300 lg:flex xl:w-[220px]"
  style="
    background-color: var(--color-background);
    border-right: 1px solid var(--color-border);
  "
>
  <!-- Avatar / Header -->
  <div
    class="flex flex-col p-4 sm:p-6"
    style="border-color: var(--color-border);"
  >
    <div class="relative mb-2 h-8 w-8 overflow-hidden rounded-full sm:mb-3">
      <img
        src={personalInfo.avatar}
        alt={personalInfo.name}
        width={1579}
        height={1579}
        loading="eager"
        fetchpriority="high"
        class="h-full w-full object-cover"
      />
    </div>

    <h1
      class="text-left text-base font-semibold sm:text-lg"
      style="color: var(--color-primary-text);"
    >
      {personalInfo.name}
    </h1>

    <p
      class="mt-1 text-left text-sm"
      style="color: var(--color-muted-text);"
    >
      {personalInfo.title}
    </p>
  </div>

  <!-- Scrollable Navigation -->
  <div class="flex-1 space-y-6 overflow-y-auto px-3 sm:px-4">
    <!-- Navigation -->
    <nav class="space-y-1">
      {
        navItems.map((item) => {
          const iconName = iconMap[item.icon] ?? "lucide:circle";
          const isExternal = !!item.href;
          const isPageLink = !!item.path && !isExternal;

          if (isExternal) {
            return (
              <a
                href={item.href}
                target="_blank"
                rel="noopener noreferrer"
                class="group flex w-full items-center gap-2 rounded-xl px-3 py-2 text-left text-xs font-medium transition-all duration-200 sm:gap-3 sm:px-4 sm:text-sm"
                style="color: var(--color-secondary-text);"
              >
                <span
                  class="flex w-4 shrink-0 items-center justify-center transition-colors duration-200"
                  style="color: var(--color-muted-text);"
                >
                  <Icon name={iconName} size={16} />
                </span>

                <span class="flex-1">
                  {item.label}
                </span>

                <Icon
                  name="lucide:external-link"
                  size={12}
                  class="shrink-0"
                  style="color: var(--color-muted-text);"
                />
              </a>
            );
          }

          if (isPageLink) {
            const linkHref = (!isHome && item.path.startsWith("#"))
              ? `/${item.path}`
              : item.path;
            return (
              <a
                href={linkHref}
                class="group flex w-full items-center gap-2 rounded-xl px-3 py-2 text-left text-xs font-medium transition-all duration-200 sm:gap-3 sm:px-4 sm:text-sm"
                style="color: var(--color-secondary-text);"
              >
                <span
                  class="flex w-4 shrink-0 items-center justify-center transition-colors duration-200"
                  style="color: var(--color-muted-text);"
                >
                  <Icon name={iconName} size={16} />
                </span>

                <span class="flex-1">
                  {item.label}
                </span>
              </a>
            );
          }

          if (isHome) {
            return (
              <button
                type="button"
                data-nav-section={item.id}
                data-active={item.id === "home" ? "true" : "false"}
                class="group flex w-full items-center gap-2 rounded-xl px-3 py-2 text-left text-xs font-medium transition-all duration-200 sm:gap-3 sm:px-4 sm:text-sm"
                style="color: var(--color-secondary-text);"
              >
                <span
                  class="flex w-4 shrink-0 items-center justify-center transition-colors duration-200"
                  style="color: var(--color-muted-text);"
                >
                  <Icon name={iconName} size={16} />
                </span>

                <span>
                  {item.label}
                </span>
              </button>
            );
          }

          return (
            <a
              href="/"
              class="group flex w-full items-center gap-2 rounded-xl px-3 py-2 text-left text-xs font-medium transition-all duration-200 sm:gap-3 sm:px-4 sm:text-sm"
              style="color: var(--color-secondary-text);"
            >
              <span
                class="flex w-4 shrink-0 items-center justify-center transition-colors duration-200"
                style="color: var(--color-muted-text);"
              >
                <Icon name={iconName} size={16} />
              </span>

              <span>
                {item.label}
              </span>
            </a>
          );
        })
      }
    </nav>

    <!-- Socials -->
    <div>
      <p
        class="mb-2 px-3 text-xs font-semibold sm:px-4"
        style="color: var(--color-primary-text);"
      >
        Socials
      </p>

      <div class="space-y-1">
        {
          socials.map((social) => {
            const iconName =
              typeof social.icon === "string"
                ? social.icon
                : null;

            return (
              <a
                href={social.href}
                target="_blank"
                rel="noopener noreferrer"
                class="group flex items-center gap-2 rounded-lg px-3 py-1.5 text-xs font-medium transition-all duration-200 sm:gap-3 sm:px-4 sm:text-sm"
                style="color: var(--color-muted-text);"
              >
                {iconName && (
                  <span class="flex w-4 shrink-0 items-center justify-center">
                    <Icon name={iconName} size={16} />
                  </span>
                )}

                <span>{social.label}</span>
              </a>
            );
          })
        }
      </div>
    </div>
  </div>

<!-- Resume Badge -->
<div class="flex justify-start px-3 py-3 sm:px-4">
  <a
    href={personalInfo.resume}
    target="_blank"
    rel="noopener noreferrer"
    class="group relative inline-flex items-center gap-2 overflow-hidden rounded-full px-3.5 py-2 text-[11px] font-semibold transition-all duration-200 hover:-translate-y-0.5"
    style="
      background-color: var(--color-accent);
      color: var(--color-button-primary-text);
    "
  >
    <span
      class="pointer-events-none absolute inset-0 -translate-x-full bg-gradient-to-r from-transparent via-white/40 to-transparent transition-transform duration-700 ease-in-out group-hover:translate-x-full"
    ></span>

    <span class="relative z-10">
      Read Resume
    </span>

    <Icon
      name="lucide:arrow-up-right"
      size={13}
      class="relative z-10 transition-transform duration-200 group-hover:translate-x-0.5 group-hover:-translate-y-0.5"
    />
  </a>
</div>

  <!-- Theme + Copyright -->
  <!-- <div class="p-3 pt-0 sm:p-4 sm:pt-0">
    <div class="flex items-center justify-between">
      <ThemeToggle />

      <p
        class="text-[10px] font-medium sm:text-xs"
        style="color: var(--color-muted-text);"
      >
        © {new Date().getFullYear()} {personalInfo.name}
      </p>
    </div>
  </div> -->
</aside>

<style>
  [data-nav-section][data-active="true"] {
    background-color: var(--nav-active-bg);
    color: var(--color-accent) !important;
    font-weight: 600;
  }

  [data-nav-section][data-active="true"] span {
    color: var(--color-accent) !important;
  }

  [data-nav-section]:hover {
    color: var(--color-primary-text);
  }

  [data-nav-section]:hover span {
    color: var(--color-primary-text);
  }

  a:hover {
    color: var(--color-primary-text);
  }
</style>