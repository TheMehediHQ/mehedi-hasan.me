---
import { Icon } from "astro-icon/components";
import { navItems } from "../../data/navItems";
import ThemeToggle from "../ThemeToggle.astro";
import LanguageSwitcher from "../LanguageSwitcher.astro";
import ScrollProgress from "../ui/ScrollProgress.astro";
import { useTranslations } from "../../i18n/ui";

const currentLocale = Astro.currentLocale ?? "en";
const t = useTranslations(currentLocale);
const isHome = Astro.url.pathname === "/" || Astro.url.pathname === "/bn" || Astro.url.pathname === "/bn/";

function getLocalizedPath(path?: string, isExternal?: boolean) {
  if (!path || isExternal) return path ?? "/";
  if (path.startsWith("#")) {
    if (isHome) return path;
    return currentLocale === "bn" ? `/bn${path}` : `/${path}`;
  }
  if (path.startsWith("/")) {
    if (currentLocale === "bn") {
      return path.startsWith("/bn") ? path : `/bn${path}`;
    }
    return path;
  }
  return path;
}

function getLocalizedLabel(id: string, defaultLabel: string) {
  const key = `nav.${id}` as any;
  const translated = t(key);
  return translated || defaultLabel;
}
---

<ScrollProgress />

<nav
  class="left-0 right-0 px-4 sm:px-8 lg:px-16"
  style="background-color: var(--color-background);"
>
  <div class="mx-auto flex max-w-3xl items-center justify-between py-4">
    <!-- Logo -->
    <a
      href={currentLocale === "bn" ? "/bn" : "/"}
      class="text-base font-semibold transition-opacity hover:opacity-70"
      style="color: var(--color-primary-text);"
    >
      mehedi-hasan.me
    </a>

    <!-- Right Controls Wrapper -->
    <div class="flex items-center gap-3 sm:gap-4 md:gap-6">
      <!-- Desktop Nav Links -->
      <div class="hidden items-center gap-6 md:flex">
        {
          navItems.map((item) => {
            const label = getLocalizedLabel(item.id, item.label);
            if (item.children && item.children.length > 0) {
              return (
                <div class="relative inline-block" id="desktop-more-dropdown">
                  <button
                    type="button"
                    id="desktop-more-btn"
                    class="flex items-center gap-1 text-sm font-medium transition-colors duration-200 hover:opacity-70 focus:outline-none cursor-pointer"
                    style="color: var(--color-secondary-text);"
                    aria-expanded="false"
                    aria-haspopup="true"
                    aria-controls="desktop-more-menu"
                  >
                    <span>{label}</span>
                    <Icon
                      name="lucide:chevron-down"
                      id="desktop-more-chevron"
                      class="h-3.5 w-3.5 transition-transform duration-200"
                    />
                  </button>

                  <div
                    id="desktop-more-menu"
                    class="invisible absolute left-1/2 top-full z-50 mt-2 min-w-[160px] -translate-x-1/2 rounded-2xl p-1.5 opacity-0 shadow-lg transition-all duration-200 focus:outline-none pointer-events-none before:absolute before:-top-3 before:left-0 before:right-0 before:h-3 before:content-['']"
                    style="background-color: var(--color-background); border: 1px solid var(--color-border);"
                    role="menu"
                    aria-orientation="vertical"
                    aria-labelledby="desktop-more-btn"
                  >
                    {item.children.map((child) => (
                      <a
                        href={getLocalizedPath(child.path, !!child.href)}
                        role="menuitem"
                        tabindex="-1"
                        class="desktop-dropdown-link block rounded-xl px-3.5 py-2 text-sm font-medium transition-colors duration-150"
                        style="color: var(--color-secondary-text);"
                      >
                        {getLocalizedLabel(child.id, child.label)}
                      </a>
                    ))}
                  </div>
                </div>
              );
            }

            const isExternal = !!item.href;

            if (isExternal) {
              return (
                <a
                  href={item.href}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="text-sm font-medium transition-colors duration-200 hover:opacity-70"
                  style="color: var(--color-secondary-text);"
                >
                  {label}
                </a>
              );
            }

            const targetPath = getLocalizedPath(item.path);

            return (
              <a
                href={targetPath}
                data-nav-section={item.id}
                class="text-sm font-medium transition-colors duration-200 hover:opacity-70"
                style="color: var(--color-secondary-text);"
              >
                {label}
              </a>
            );
          })
        }
      </div>

      <!-- Action Icons: RSS, LanguageSwitcher, ThemeToggle -->
      <div class="flex items-center gap-2 sm:gap-2.5">
        <a
          href="/rss.xml"
          class="flex h-8 w-8 items-center justify-center rounded-lg transition-colors hover:bg-[var(--nav-active-bg)]"
          style="color: var(--color-primary-text);"
          aria-label="RSS feed"
        >
          <Icon name="lucide:rss" class="h-4 w-4" />
        </a>

        <LanguageSwitcher />

        <ThemeToggle />
      </div>

      <!-- Hamburger Button (Mobile only) -->
      <button
        id="hamburger-btn"
        type="button"
        class="text-sm font-medium transition-opacity hover:opacity-70 md:hidden cursor-pointer"
        style="color: var(--color-primary-text);"
        aria-label="Toggle menu"
        data-menu-text={t("nav.menu")}
        data-close-text={t("nav.close")}
      >
        {t("nav.menu")}
      </button>
    </div>
  </div>
</nav>

<!-- Mobile Menu Overlay -->
<div
  id="mobile-menu-overlay"
  class="fixed inset-0 z-[60] hidden md:hidden"
  style="background-color: rgba(0,0,0,0.5);"
>
  <div
    class="absolute top-16 left-4 right-4 rounded-2xl p-2 sm:left-6 sm:right-6"
    style="background-color: var(--color-background); border: 1px solid var(--color-border);"
  >
    <nav class="flex flex-col">
      {
        navItems.map((item) => {
          const label = getLocalizedLabel(item.id, item.label);
          if (item.children && item.children.length > 0) {
            return (
              <div class="flex flex-col">
                <button
                  type="button"
                  id="mobile-more-btn"
                  class="mobile-nav-link flex w-full items-center justify-between rounded-xl px-4 py-3 text-sm font-medium transition-colors text-left cursor-pointer"
                  style="color: var(--color-secondary-text);"
                  aria-expanded="false"
                  aria-controls="mobile-more-menu"
                >
                  <span>{label}</span>
                  <Icon
                    name="lucide:chevron-down"
                    id="mobile-more-chevron"
                    class="h-4 w-4 transition-transform duration-200"
                  />
                </button>
                <div
                  id="mobile-more-menu"
                  class="hidden flex-col pl-4 pb-1 space-y-1"
                >
                  {item.children.map((child) => (
                    <a
                      href={getLocalizedPath(child.path, !!child.href)}
                      class="mobile-nav-link rounded-xl px-4 py-2.5 text-sm font-medium transition-colors"
                      style="color: var(--color-secondary-text);"
                    >
                      {getLocalizedLabel(child.id, child.label)}
                    </a>
                  ))}
                </div>
              </div>
            );
          }

          const isExternal = !!item.href;

          if (isExternal) {
            return (
              <a
                href={item.href}
                target="_blank"
                rel="noopener noreferrer"
                class="mobile-nav-link rounded-xl px-4 py-3 text-sm font-medium transition-colors"
                style="color: var(--color-secondary-text);"
              >
                {label}
              </a>
            );
          }

          const targetPath = getLocalizedPath(item.path);

          return (
            <a
              href={targetPath}
              data-nav-section={item.id}
              class="mobile-nav-link rounded-xl px-4 py-3 text-sm font-medium transition-colors"
              style="color: var(--color-secondary-text);"
            >
              {label}
            </a>
          );
        })
      }
    </nav>
  </div>
</div>

<style>
  [data-nav-section][data-active="true"] {
    color: var(--color-accent) !important;
  }

  .mobile-nav-link:hover,
  .desktop-dropdown-link:hover {
    background-color: var(--color-hover);
    color: var(--color-primary-text);
  }

  #desktop-more-menu.open {
    visibility: visible;
    opacity: 1;
    pointer-events: auto;
  }
</style>

<script>
  function setupNav() {
    const hamburgerBtn = document.getElementById("hamburger-btn");
    const mobileMenuOverlay = document.getElementById("mobile-menu-overlay");
    const mobileMoreBtn = document.getElementById("mobile-more-btn");
    const mobileMoreMenu = document.getElementById("mobile-more-menu");
    const mobileMoreChevron = document.getElementById("mobile-more-chevron");

    function closeMobileMenu() {
      if (mobileMenuOverlay && hamburgerBtn) {
        mobileMenuOverlay.classList.add("hidden");
        hamburgerBtn.textContent = hamburgerBtn.getAttribute("data-menu-text") || "Menu";
        if (mobileMoreMenu && !mobileMoreMenu.classList.contains("hidden")) {
          mobileMoreMenu.classList.add("hidden");
          mobileMoreMenu.classList.remove("flex");
          mobileMoreBtn?.setAttribute("aria-expanded", "false");
          mobileMoreChevron?.classList.remove("rotate-180");
        }
      }
    }

    if (hamburgerBtn && mobileMenuOverlay) {
      hamburgerBtn.addEventListener("click", () => {
        const isHidden = mobileMenuOverlay.classList.contains("hidden");
        if (isHidden) {
          mobileMenuOverlay.classList.remove("hidden");
          hamburgerBtn.textContent = hamburgerBtn.getAttribute("data-close-text") || "Close";
        } else {
          closeMobileMenu();
        }
      });

      mobileMenuOverlay.addEventListener("click", (e) => {
        if (e.target === mobileMenuOverlay) {
          closeMobileMenu();
        }
      });

      mobileMenuOverlay.querySelectorAll("a").forEach((link) => {
        link.addEventListener("click", () => {
          closeMobileMenu();
        });
      });
    }

    if (mobileMoreBtn && mobileMoreMenu) {
      mobileMoreBtn.addEventListener("click", (e) => {
        e.stopPropagation();
        const isHidden = mobileMoreMenu.classList.contains("hidden");
        mobileMoreMenu.classList.toggle("hidden", !isHidden);
        mobileMoreMenu.classList.toggle("flex", isHidden);
        mobileMoreBtn.setAttribute("aria-expanded", String(isHidden));
        if (mobileMoreChevron) {
          mobileMoreChevron.classList.toggle("rotate-180", isHidden);
        }
      });
    }

    // Desktop "More" dropdown
    const desktopMoreDropdown = document.getElementById("desktop-more-dropdown");
    const desktopMoreBtn = document.getElementById("desktop-more-btn");
    const desktopMoreMenu = document.getElementById("desktop-more-menu");
    const desktopMoreChevron = document.getElementById("desktop-more-chevron");

    if (desktopMoreDropdown && desktopMoreBtn && desktopMoreMenu) {
      let closeTimer: ReturnType<typeof setTimeout> | null = null;

      const openMenu = () => {
        if (closeTimer) {
          clearTimeout(closeTimer);
          closeTimer = null;
        }
        desktopMoreMenu.classList.add("open");
        desktopMoreBtn.setAttribute("aria-expanded", "true");
        desktopMoreChevron?.classList.add("rotate-180");
      };

      const closeMenu = () => {
        desktopMoreMenu.classList.remove("open");
        desktopMoreBtn.setAttribute("aria-expanded", "false");
        desktopMoreChevron?.classList.remove("rotate-180");
      };

      desktopMoreDropdown.addEventListener("mouseenter", openMenu);
      desktopMoreDropdown.addEventListener("mouseleave", () => {
        closeTimer = setTimeout(closeMenu, 150);
      });

      desktopMoreBtn.addEventListener("click", (e) => {
        e.stopPropagation();
        const isOpen = desktopMoreMenu.classList.contains("open");
        if (isOpen) {
          closeMenu();
        } else {
          openMenu();
        }
      });

      document.addEventListener("click", (e) => {
        if (!desktopMoreDropdown.contains(e.target as Node)) {
          closeMenu();
        }
      });

      const menuLinks = Array.from(desktopMoreMenu.querySelectorAll<HTMLAnchorElement>("a"));

      desktopMoreDropdown.addEventListener("keydown", (e) => {
        if (e.key === "Escape") {
          closeMenu();
          desktopMoreBtn.focus();
        }
      });

      desktopMoreBtn.addEventListener("keydown", (e) => {
        if (e.key === "ArrowDown") {
          e.preventDefault();
          openMenu();
          menuLinks[0]?.focus();
        }
      });

      menuLinks.forEach((link, idx) => {
        link.addEventListener("keydown", (e) => {
          if (e.key === "ArrowDown") {
            e.preventDefault();
            menuLinks[(idx + 1) % menuLinks.length]?.focus();
          } else if (e.key === "ArrowUp") {
            e.preventDefault();
            menuLinks[(idx - 1 + menuLinks.length) % menuLinks.length]?.focus();
          } else if (e.key === "Home") {
            e.preventDefault();
            menuLinks[0]?.focus();
          } else if (e.key === "End") {
            e.preventDefault();
            menuLinks[menuLinks.length - 1]?.focus();
          }
        });

        link.addEventListener("click", () => {
          closeMenu();
        });
      });
    }
  }

  setupNav();
  document.addEventListener("astro:page-load", setupNav);
</script>
