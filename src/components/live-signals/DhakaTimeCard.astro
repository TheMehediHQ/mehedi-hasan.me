---
import { Icon } from "astro-icon/components";
---

<div
  class="relative h-[220px] rounded-2xl p-6 border border-(--color-border) shadow-xl flex flex-col justify-between overflow-hidden group"
  style="background: linear-gradient(to bottom, #1E1E1E, #141414);"
>
  <!-- Ambient Background Glow -->
  <div
    class="absolute -top-12 -right-12 w-32 h-32 rounded-full blur-2xl pointer-events-none transition-all duration-500"
    style="background-color: rgba(59, 130, 246, 0.1);"
  ></div>

  <!-- Top Bar: Title & Icon -->
  <div class="flex items-center justify-between relative z-10">
    <span
      class="text-[11px] font-bold uppercase tracking-widest"
      style="color: rgba(163, 163, 163, 0.9);"
    >
      Local Time
    </span>

    <Icon
      name="lucide:globe-2"
      class="w-5 h-5"
      style="color: #A3A3A3;"
    />
  </div>

  <!-- Main Time Display -->
  <div class="my-auto relative z-10">
    <div class="flex items-baseline gap-2">
      <span
        id="dhaka-time"
        class="text-4xl font-extrabold tracking-tight font-mono drop-shadow-md"
        style="color: #FFFFFF;"
      >
        --:--:--
      </span>

      <span
        id="dhaka-period"
        class="text-xs font-semibold uppercase tracking-wider px-2 py-0.5 rounded-md backdrop-blur-sm hidden"
        style="color: #60A5FA; background-color: rgba(59, 130, 246, 0.1); border: 1px solid rgba(59, 130, 246, 0.2);"
      >
        --
      </span>
    </div>

    <p
      class="text-xs font-medium mt-2 flex items-center gap-1.5"
      style="color: #A3A3A3;"
    >
      <span>Dhaka, Bangladesh</span>

      <span style="color: #525252;">•</span>

      <span class="font-mono" style="color: #737373;">
        GMT+6
      </span>
    </p>
  </div>

  <!-- Bottom Bar: Status -->
  <div
    class="pt-3 border-t text-xs flex justify-between items-center relative z-10"
    style="border-color: var(--color-border);"
  >
    <span class="font-medium" style="color: #737373;">
      Status
    </span>

    <!-- Active Status -->
    <div
      class="flex items-center gap-2 px-2.5 py-1 rounded-full"
    >
      <span class="relative flex h-2 w-2">
        <!-- Pulse Ring -->
        <span
          class="absolute -left-1 -top-1 h-4 w-4 rounded-full animate-[ping_2.5s_ease-out_infinite]"
          style="background-color: rgba(52, 211, 153, 0.4);"
        ></span>

        <!-- Soft Glow -->
        <span
          class="absolute -left-0.5 -top-0.5 h-3 w-3 rounded-full"
          style="background-color: rgba(52, 211, 153, 0.3); filter: blur(8px);"
        ></span>

        <!-- Active Dot -->
        <span
          class="relative inline-flex h-2 w-2 rounded-full"
          style="background-color: #10B981; box-shadow: 0 0 8px rgba(16, 185, 129, 0.8);"
        ></span>
      </span>

      <span
        class="font-medium text-[11px] tracking-wide"
        style="color: #34D399;"
      >
        Active
      </span>
    </div>
  </div>
</div>

<script>
  function updateDhakaTime() {
    const now = new Date();

    const formattedTime = now.toLocaleTimeString("en-US", {
      timeZone: "Asia/Dhaka",
      hour: "numeric",
      minute: "2-digit",
      second: "2-digit",
      hour12: true,
    });

    const [time, period] = formattedTime.split(" ");

    const timeElement = document.getElementById("dhaka-time");
    const periodElement = document.getElementById("dhaka-period");

    if (timeElement) {
      timeElement.textContent = time || "--:--:--";
    }

    if (periodElement) {
      periodElement.textContent = period || "--";
      periodElement.classList.remove("hidden");
    }
  }

  function initDhakaClock() {
    updateDhakaTime();

    const timer = window.setInterval(updateDhakaTime, 1000);

    document.addEventListener(
      "astro:before-swap",
      () => {
        window.clearInterval(timer);
      },
      { once: true }
    );
  }

  document.addEventListener("astro:page-load", initDhakaClock);

  if (
    document.readyState === "complete" ||
    document.readyState === "interactive"
  ) {
    initDhakaClock();
  } else {
    document.addEventListener("DOMContentLoaded", initDhakaClock);
  }
</script>