---
import { Icon } from "astro-icon/components";
---

<div
  class="relative h-[220px] rounded-2xl p-6 bg-gradient-to-b from-[#1E1E1E] to-[#141414] border border-(--color-border) shadow-xl flex flex-col justify-between overflow-hidden group"
>
  <!-- Ambient Background Glow Effect -->
  <div
    class="absolute -top-12 -right-12 w-32 h-32 bg-blue-500/10 rounded-full blur-2xl pointer-events-none group-hover:bg-blue-500/20 transition-all duration-500"
  ></div>

  <!-- Top Bar: Title & Icon -->
  <div class="flex items-center justify-between relative z-10">
    <span
      class="text-[11px] font-bold uppercase tracking-widest text-neutral-400/90 flex items-center gap-2"
    >
      <span class="w-1.5 h-1.5 rounded-full bg-blue-400 animate-pulse"></span>

      Local Time
    </span>

    <Icon
      name="lucide:globe-2"
      class="w-5 h-5 text-neutral-400 group-hover:text-blue-400 transition-colors duration-300 animate-spin-slow"
    />
  </div>

  <!-- Main Time Display -->
  <div class="my-auto relative z-10">
    <div class="flex items-baseline gap-2">
      <span
        id="dhaka-time"
        class="text-4xl font-extrabold text-white tracking-tight font-mono drop-shadow-md"
      >
        --:--:--
      </span>

      <span
        id="dhaka-period"
        class="text-xs font-semibold uppercase tracking-wider text-blue-400 bg-blue-500/10 border border-blue-500/20 px-2 py-0.5 rounded-md backdrop-blur-sm hidden"
      >
        --
      </span>
    </div>

    <p
      class="text-xs font-medium text-neutral-400 mt-2 flex items-center gap-1.5"
    >
      <span>Dhaka, Bangladesh</span>

      <span class="text-neutral-600">•</span>

      <span class="text-neutral-500 font-mono">
        GMT+6
      </span>
    </p>
  </div>

  <!-- Bottom Bar: Status -->
  <div
    class="pt-3 border-t border-(--color-border) text-xs text-neutral-400 flex justify-between items-center relative z-10"
  >
    <span class="font-medium text-neutral-500">
      Status
    </span>

    <div
      class="flex items-center gap-2 bg-emerald-500/10 border border-emerald-500/20 px-2.5 py-1 rounded-full"
    >
      <span class="relative flex h-2 w-2">
        <span
          class="animate-ping absolute inline-flex h-full w-full rounded-full bg-emerald-400 opacity-75"
        ></span>

        <span
          class="relative inline-flex rounded-full h-2 w-2 bg-emerald-500"
        ></span>
      </span>

      <span
        class="text-emerald-400 font-medium text-[11px] tracking-wide"
      >
        Active
      </span>
    </div>
  </div>
</div>

<script>
  function updateDhakaTime() {
    const now = new Date();

    const formattedTime = now.toLocaleTimeString("en-US", {
      timeZone: "Asia/Dhaka",
      hour: "numeric",
      minute: "2-digit",
      second: "2-digit",
      hour12: true,
    });

    const [time, period] = formattedTime.split(" ");

    const timeElement = document.getElementById("dhaka-time");
    const periodElement = document.getElementById("dhaka-period");

    if (timeElement) {
      timeElement.textContent = time || "--:--:--";
    }

    if (periodElement) {
      periodElement.textContent = period || "--";
      periodElement.classList.remove("hidden");
    }
  }

  function initDhakaClock() {
    updateDhakaTime();

    const timer = window.setInterval(updateDhakaTime, 1000);

    document.addEventListener(
      "astro:before-swap",
      () => {
        window.clearInterval(timer);
      },
      { once: true }
    );
  }

  document.addEventListener("astro:page-load", initDhakaClock);

  if (
    document.readyState === "complete" ||
    document.readyState === "interactive"
  ) {
    initDhakaClock();
  } else {
    document.addEventListener("DOMContentLoaded", initDhakaClock);
  }
</script>