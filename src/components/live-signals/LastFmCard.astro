---
import { Icon } from "astro-icon/components";

const lastfmUsername = import.meta.env.LASTFM_USERNAME || "themehedihq";
const fallbackUrl = `https://www.last.fm/user/${lastfmUsername}`;
---

<a
  id="music-card"
  href={fallbackUrl}
  target="_blank"
  rel="noopener noreferrer"
  class="relative h-[220px] rounded-2xl p-5 bg-[#181818] border shadow-lg flex flex-col justify-between overflow-hidden group transition-all duration-300 no-underline select-none"
  style="border-color: rgba(255, 255, 255, 0.18);"
>
  <!-- Dynamic Background Blur -->
  <div
    id="music-bg-blur"
    class="absolute inset-0 pointer-events-none transition-all duration-700"
    style="background-size: cover; background-position: center; transform: scale(1.5); filter: blur(40px); opacity: 0.6;"
  ></div>

  <!-- Dark Overlay -->
  <div
    class="absolute inset-0 pointer-events-none"
    style="background-color: rgba(0, 0, 0, 0.4); backdrop-filter: blur(2px);"
  ></div>

  <!-- Top Section -->
  <div class="relative z-10 flex items-start justify-between">
    <!-- Spotify Icon -->
    <Icon
      name="fa6-brands:spotify"
      size={32}
      class="text-[#1DB954]"
    />

    <!-- CD + Album Art -->
    <div class="relative flex items-center justify-end">
      <!-- Realistic Black CD -->
      <div
        class="cd-disc absolute top-2 right-12 flex h-18 w-18 items-center justify-center overflow-hidden rounded-full bg-[#050505]"
      >
        <!-- Rotating Light Reflection -->
        <div
          class="cd-reflection pointer-events-none absolute inset-[-35%] rounded-full"
        ></div>

        <!-- Subtle Disc Surface -->
        <div
          class="pointer-events-none absolute inset-0 rounded-full"
          style="
            background:
              radial-gradient(
                circle at 50% 50%,
                transparent 0%,
                transparent 18%,
                rgba(255,255,255,0.025) 19%,
                transparent 20%,
                transparent 32%,
                rgba(255,255,255,0.018) 33%,
                transparent 34%,
                transparent 46%,
                rgba(255,255,255,0.025) 47%,
                transparent 48%,
                transparent 60%,
                rgba(255,255,255,0.018) 61%,
                transparent 62%,
                transparent 74%,
                rgba(255,255,255,0.02) 75%,
                transparent 76%
              );
          "
        ></div>

        <!-- Fine Grooves -->
        <div
          class="absolute inset-[3px] rounded-full border border-white/[0.025]"
        ></div>

        <div
          class="absolute inset-[6px] rounded-full border border-white/[0.018]"
        ></div>

        <div
          class="absolute inset-[10px] rounded-full border border-white/[0.025]"
        ></div>

        <div
          class="absolute inset-[14px] rounded-full border border-white/[0.018]"
        ></div>

        <!-- Inner Ring -->
        <div
          class="absolute inset-[17px] rounded-full border border-white/[0.015]"
        ></div>

        <!-- Center Label -->
        <div
          class="relative flex h-6 w-6 items-center justify-center rounded-full bg-[#101010] shadow-[inset_0_0_5px_rgba(255,255,255,0.08)]"
        >
          <!-- Center Hole -->
          <div
            class="h-2.5 w-2.5 rounded-full bg-[#020202]"
          ></div>
        </div>
      </div>

      <!-- Album Cover -->
      <div
        class="relative z-10 flex h-22 w-22 items-center justify-center overflow-hidden rounded-xl border bg-neutral-900 shadow-lg"
        style="border-color: rgba(255, 255, 255, 0.18);"
      >
        <img
          id="album-art"
          src=""
          alt=""
          class="hidden h-full w-full object-cover"
        />

        <div
          id="no-cover"
          class="flex h-full w-full flex-col items-center justify-center p-1 text-center"
          style="background: linear-gradient(to bottom right, #262626, #171717);"
        >
          <span
            class="text-[10px] font-medium leading-tight"
            style="color: #A3A3A3;"
          >
            No Cover
          </span>
        </div>
      </div>
    </div>
  </div>

  <!-- Bottom Info -->
  <div class="relative z-10">
    <!-- Music Status -->
    <div class="mb-1.5 flex items-center gap-2">
      <div class="flex h-3.5 items-end gap-[2px]">
        <span
          id="bar1"
          class="eq-bar h-2 w-[2.5px]"
        ></span>

        <span
          id="bar2"
          class="eq-bar h-3.5 w-[2.5px]"
        ></span>

        <span
          id="bar3"
          class="eq-bar h-1.5 w-[2.5px]"
        ></span>
      </div>

      <span
        id="music-status"
        class="text-xs font-medium tracking-wide text-[#1DB954]"
      >
        Loading...
      </span>
    </div>

    <!-- Track Details -->
    <div>
      <h3
        id="track-title"
        class="truncate text-lg font-bold leading-snug"
        style="color: #FFFFFF;"
        title="Off Endz"
      >
        Off Endz
      </h3>

      <p
        id="track-artist"
        class="truncate text-sm font-medium"
        style="color: #D4D4D4;"
        title="Raf Saperra"
      >
        Raf Saperra
      </p>
    </div>
  </div>
</a>

<style>
  /* ============================= */
  /* Realistic CD */
  /* ============================= */

  .cd-disc {
    animation: cd-spin 5s linear infinite;
    transform-origin: center;

    box-shadow:
      0 10px 25px rgba(0, 0, 0, 0.65),
      0 0 12px rgba(255, 255, 255, 0.035);
  }

  /* Rotating Light Reflection */

  .cd-reflection {
    background: conic-gradient(
      from 0deg,
      transparent 0deg,
      transparent 25deg,
      rgba(255, 255, 255, 0.04) 38deg,
      rgba(255, 255, 255, 0.14) 45deg,
      rgba(255, 255, 255, 0.035) 53deg,
      transparent 68deg,
      transparent 155deg,
      rgba(255, 255, 255, 0.035) 170deg,
      rgba(255, 255, 255, 0.08) 180deg,
      rgba(255, 255, 255, 0.025) 190deg,
      transparent 205deg,
      transparent 360deg
    );

    animation: cd-reflection 3.2s linear infinite;
    filter: blur(0.3px);
  }

  @keyframes cd-spin {
    from {
      transform: rotate(0deg);
    }

    to {
      transform: rotate(360deg);
    }
  }

  @keyframes cd-reflection {
    from {
      transform: rotate(0deg);
    }

    to {
      transform: rotate(-360deg);
    }
  }

  /* ============================= */
  /* Equalizer */
  /* ============================= */

  .eq-bar {
    display: block;
    border-radius: 9999px;
    background: #1db954;
  }

  .eq-bar.is-playing {
    animation: equalizer 0.8s ease-in-out infinite;
  }

  #bar1.is-playing {
    animation-duration: 0.85s;
  }

  #bar2.is-playing {
    animation-duration: 1.1s;
  }

  #bar3.is-playing {
    animation-duration: 0.65s;
  }

  @keyframes equalizer {
    0%,
    100% {
      transform: scaleY(0.35);
    }

    50% {
      transform: scaleY(1);
    }
  }
</style>

<script>
  async function fetchLastFmTrack() {
    try {
      const res = await fetch("/api/lastfm");

      if (!res.ok) return;

      const data = await res.json();

      const track = data?.track;

      if (!track) return;

      const {
        title,
        artist,
        isPlaying,
        trackUrl,
        albumArtUrl,
      } = track;

      const musicCard =
        document.getElementById(
          "music-card"
        ) as HTMLAnchorElement | null;

      const albumArt =
        document.getElementById(
          "album-art"
        ) as HTMLImageElement | null;

      const noCover =
        document.getElementById("no-cover");

      const bgBlur =
        document.getElementById("music-bg-blur");

      const statusEl =
        document.getElementById("music-status");

      const titleEl =
        document.getElementById("track-title");

      const artistEl =
        document.getElementById("track-artist");

      const bar1 =
        document.getElementById("bar1");

      const bar2 =
        document.getElementById("bar2");

      const bar3 =
        document.getElementById("bar3");

      /* Card Link */
      if (musicCard && trackUrl) {
        musicCard.href = trackUrl;
      }

      /* Track Title */
      if (titleEl) {
        titleEl.textContent = title;
        titleEl.title = title;
      }

      /* Artist */
      if (artistEl) {
        artistEl.textContent = artist;
        artistEl.title = artist;
      }

      /* Status */
      if (statusEl) {
        statusEl.textContent = isPlaying
          ? "Now playing"
          : "Last played";
      }

      /* Album Art */
      if (albumArt && albumArtUrl) {
        albumArt.src = albumArtUrl;
        albumArt.alt = title;

        albumArt.classList.remove("hidden");

        albumArt.onerror = () => {
          albumArt.classList.add("hidden");

          if (noCover) {
            noCover.classList.remove("hidden");
          }
        };

        if (noCover) {
          noCover.classList.add("hidden");
        }

        /* Dynamic Background */
        if (bgBlur) {
          bgBlur.style.backgroundImage =
            `url(${albumArtUrl})`;
        }
      }

      /* Music Bars */
      if (isPlaying) {
        bar1?.classList.add("is-playing");
        bar2?.classList.add("is-playing");
        bar3?.classList.add("is-playing");
      } else {
        bar1?.classList.remove("is-playing");
        bar2?.classList.remove("is-playing");
        bar3?.classList.remove("is-playing");
      }
    } catch (error) {
      console.error(
        "Failed to fetch Last.fm track:",
        error
      );
    }
  }

  /* ============================= */
  /* Initialize Last.fm */
  /* ============================= */

  function initLastFm() {
    fetchLastFmTrack();

    const musicInterval =
      setInterval(fetchLastFmTrack, 30000);

    document.addEventListener(
      "astro:before-swap",
      () => {
        clearInterval(musicInterval);
      },
      {
        once: true,
      }
    );
  }

  /* Astro Page Load */
  document.addEventListener(
    "astro:page-load",
    initLastFm
  );

  /* Initial Load */
  if (
    document.readyState === "complete" ||
    document.readyState === "interactive"
  ) {
    initLastFm();
  } else {
    document.addEventListener(
      "DOMContentLoaded",
      initLastFm
    );
  }
</script>