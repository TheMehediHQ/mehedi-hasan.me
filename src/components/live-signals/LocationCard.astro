---
---

<div class="relative h-[220px] overflow-hidden rounded-2xl border bg-neutral-900 shadow-lg" style="border-color: rgba(255, 255, 255, 0.18);">
  <!-- Dhaka Map -->
  <div
    class="absolute inset-0 bg-center bg-no-repeat opacity-90"
    style="
      background-image: url('/profile/dhaka.png');
      background-size: 240%;
    "
  ></div>

  <!-- Dark Gradient -->
  <div
    class="absolute inset-0"
    style="background: linear-gradient(to top, rgba(0,0,0,0.8), rgba(0,0,0,0.2) 50%, transparent);"
  ></div>

  <!-- Live Location Marker -->
  <div class="absolute inset-0 flex items-center justify-center">
    <div class="relative flex items-center justify-center">
      <!-- Slow pulse ring -->
      <span
        class="absolute h-10 w-10 animate-[ping_2.5s_ease-out_infinite] rounded-full"
        style="background-color: rgba(59, 130, 246, 0.3);"
      ></span>

      <!-- Soft glow -->
      <span
        class="absolute h-7 w-7 rounded-full"
        style="background-color: rgba(59, 130, 246, 0.25); filter: blur(8px);"
      ></span>

      <!-- Location dot -->
      <span
        class="relative h-4 w-4 rounded-full"
        style="border: 3px solid white; background-color: #3B82F6; box-shadow: 0 0 14px rgba(59, 130, 246, 0.85);"
      ></span>
    </div>
  </div>

  <!-- Location Label -->
  <a
    href="https://en.wikipedia.org/wiki/Dhaka"
    target="_blank"
    rel="noopener noreferrer"
    class="absolute bottom-3 right-3 rounded-lg border px-3 py-1.5 text-xs font-medium backdrop-blur-md transition-all duration-200 hover:scale-105"
    style="background-color: rgba(0, 0, 0, 0.7); color: #E5E7EB; border-color: rgba(255, 255, 255, 0.18);"
  >
    Dhaka, BD
  </a>
</div>