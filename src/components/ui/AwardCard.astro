---
import { Icon } from "astro-icon/components";
import type { Award } from "@/types";
import Badge from "./Badge.astro";

interface Props {
  award: Award;
  index: number;
}

const { award, index = 0 } = Astro.props;
---

<div class="animate-on-scroll" style={`transition-delay: ${index * 0.1}s`}>
  <div
    class="transition-all duration-300 h-full btn-flicker-fix block"
    style="border-color: var(--btn-border);"
  >
    <div class="flex flex-col sm:flex-row sm:items-start sm:justify-between gap-3 sm:gap-4 mb-3 sm:mb-4">
      <div class="flex items-center gap-2.5 sm:gap-3">
        <div
          class="flex-shrink-0 w-9 h-9 rounded-full flex items-center justify-center overflow-hidden"
          style="background-color: var(--color-button-secondary-bg);"
        >
          <Icon
            name={award.icon || "lucide:trophy"}
            class="w-5 h-5"
            style="color: var(--color-accent);"
          />
        </div>

        <div>
          <h3
            class="text-base sm:text-lg font-semibold"
            style="color: var(--color-primary-text);"
          >
            {award.title}
          </h3>
          <p
            class="text-xs sm:text-sm"
            style="color: var(--color-accent);"
          >
            {award.organization}
          </p>
        </div>
      </div>

      <div
        class="flex items-center gap-1.5 text-xs sm:text-sm shrink-0"
        style="color: var(--color-muted-text);"
      >
        <Icon name="lucide:calendar" size={12} />
        {award.date}
      </div>
    </div>

    <p
      class="text-sm leading-6 mb-3 sm:mb-4"
      style="color: var(--color-secondary-text);"
    >
      {award.description}
    </p>

    <div class="flex flex-wrap items-center justify-between gap-2">
      <div class="flex flex-wrap gap-1.5 sm:gap-2">
        {award.tags.map((tag) => (
          <Badge variant="default">{tag}</Badge>
        ))}
      </div>

      {award.credentialUrl && (
        <a
          href={award.credentialUrl}
          target="_blank"
          rel="noopener noreferrer"
          class="flex items-center gap-1 text-xs font-medium shrink-0 hover:opacity-70 transition-opacity"
          style="color: var(--color-accent);"
        >
          View Recognition
          <Icon name="lucide:external-link" size={12} />
        </a>
      )}
    </div>
  </div>
</div>

<style>
  .animate-on-scroll {
    opacity: 0;
    transform: translateX(-20px);
    transition: opacity 0.4s ease, transform 0.4s ease;
  }
  .animate-on-scroll.visible {
    opacity: 1;
    transform: translateX(0);
  }
</style>

<script>
  const observer = new IntersectionObserver(
    (entries) => {
      entries.forEach((entry) => {
        if (entry.isIntersecting) {
          entry.target.classList.add("visible");
          observer.unobserve(entry.target);
        }
      });
    },
    { threshold: 0.1, rootMargin: "-10%" }
  );
  document.querySelectorAll(".animate-on-scroll").forEach((el) => observer.observe(el));
</script>
