---
interface Props {
  variant?: "default" | "primary" | "success";
  class?: string;
}

const { variant = "default", class: className = "" } = Astro.props;

const variantStyles = {
  default:
    "background-color: var(--color-surface); color: var(--color-secondary-text); border: 1px solid var(--color-border);",
  primary:
    "background-color: var(--color-accent); color: var(--color-button-primary-text); border: none;",
  success: "background-color: #059669; color: #FFFFFF; border: none;",
};
---

<span
  class:list={["inline-flex items-center px-3 py-1 rounded-full text-xs font-medium", className]}
  style={variantStyles[variant]}
>
  <slot />
</span>
