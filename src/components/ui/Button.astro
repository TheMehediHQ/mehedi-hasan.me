---
import { cn } from "@/lib/utils";

interface Props {
  variant?: "primary" | "secondary" | "ghost";
  size?: "sm" | "md" | "lg";
  class?: string;
  type?: "button" | "submit" | "reset";
  disabled?: boolean;
}

const {
  variant = "primary",
  size = "md",
  class: className = "",
  type = "button",
  disabled = false,
} = Astro.props;

const base =
  "inline-flex items-center justify-center gap-2 rounded-xl font-medium transition-all duration-200 focus:outline-none disabled:opacity-50 disabled:cursor-not-allowed btn-flicker-fix";

const variantClasses = {
  primary:
    "bg-[var(--color-accent)] text-[var(--color-button-primary-text)] border-none hover:!bg-[var(--color-accent-hover)] hover:!shadow-md active:scale-95",
  secondary:
    "bg-transparent text-[var(--color-button-secondary-text)] border border-[var(--secondary-border)] hover:!bg-[var(--color-hover)] hover:!border-[var(--color-hover-border)] active:scale-95",
  ghost:
    "bg-transparent text-[var(--color-secondary-text)] border-none hover:!bg-[var(--color-hover)] active:scale-95",
};

const sizes = {
  sm: "px-2 py-1 text-sm",
  md: "px-5 py-2.5 text-sm",
  lg: "px-8 py-3.5 text-base",
};
---

<button
  type={type}
  class={cn(base, sizes[size], variantClasses[variant], className)}
  disabled={disabled}
>
  <slot />
</button>
