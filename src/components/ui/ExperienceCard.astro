---
import { Icon } from "astro-icon/components";
import type { Experience } from "@/types";
import Badge from "./Badge.astro";

interface Props {
  experience: Experience;
  index: number;
}

const { experience, index = 0 } = Astro.props;
---

<div class="animate-on-scroll" style={`transition-delay: ${index * 0.08}s`}>
  <div
    class="transition-transform duration-300 h-full btn-flicker-fix"
    style="border-color: var(--btn-border); transform: translateZ(0);"
  >
    <div class="flex flex-col sm:flex-row sm:items-start sm:justify-between gap-3 sm:gap-4 mb-3 sm:mb-4">
      <div>
        <h3
          class="text-base sm:text-lg font-semibold"
          style="color: var(--color-primary-text);"
        >
          {experience.role}
        </h3>
        <p
          class="text-xs sm:text-sm"
          style="color: var(--color-accent);"
        >
          {experience.companyUrl ? (
            <a
              href={experience.companyUrl}
              target="_blank"
              rel="noopener noreferrer"
              class="company-link inline-flex items-center gap-1"
            >
              {experience.company}
              <Icon name="lucide:arrow-up-right" size={12} class="opacity-0 -translate-x-1 transition-all duration-200" />
            </a>
          ) : (
            experience.company
          )}
        </p>
      </div>

      <div
        class="text-xs sm:text-sm sm:mt-0"
        style="color: var(--color-muted-text);"
      >
        {experience.period}
      </div>
    </div>

    <p
      class="text-sm leading-6 mb-3 sm:mb-4"
      style="color: var(--color-secondary-text);"
    >
      {experience.description}
    </p>

    <div class="flex flex-wrap gap-1.5 sm:gap-2">
      {experience.type === "volunteer" && (
        <Badge variant="default">Volunteer</Badge>
      )}
      {experience.technologies?.map((tech) => (
        <Badge variant="default">{tech}</Badge>
      ))}
    </div>
  </div>
</div>

<style>
  .animate-on-scroll {
    opacity: 0;
    transform: translateX(-10px);
    transition: opacity 0.35s ease, transform 0.35s ease;
  }
  .animate-on-scroll.visible {
    opacity: 1;
    transform: translateX(0);
  }
  .company-link {
    position: relative;
    text-decoration: none;
    transition: color 0.2s ease;
  }
  .company-link::after {
    content: "";
    position: absolute;
    left: 0;
    bottom: -1px;
    width: 0;
    height: 1px;
    background-color: var(--color-accent);
    transition: width 0.25s ease;
  }
  .company-link:hover::after {
    width: 100%;
  }
  .company-link:hover svg {
    opacity: 1;
    transform: translateX(0);
  }
</style>

<script>
  const observer = new IntersectionObserver(
    (entries) => {
      entries.forEach((entry) => {
        if (entry.isIntersecting) {
          entry.target.classList.add("visible");
          observer.unobserve(entry.target);
        }
      });
    },
    { threshold: 0.1, rootMargin: "-10%" }
  );
  document.querySelectorAll(".animate-on-scroll").forEach((el) => observer.observe(el));
</script>
