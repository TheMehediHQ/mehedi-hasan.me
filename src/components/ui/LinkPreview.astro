---
interface Props {
  url: string;
  imageSrc: string;
  text: string;
  class?: string;
}

const { url, imageSrc, text, class: className = "" } = Astro.props;
---

<span class:list={["link-preview-wrapper", className]}>
  <a
    href={url}
    class="link-preview-trigger"
    target="_blank"
    rel="noopener noreferrer"
  >
    {text}
  </a>
  <span class="link-preview-card">
    <img src={imageSrc} alt={`Preview of ${text}`} class="link-preview-image" />
  </span>
</span>

<style>
  .link-preview-wrapper {
    position: relative;
    display: inline;
  }

  .link-preview-trigger {
    color: var(--color-accent, #6366f1);
    text-decoration: underline;
    text-decoration-style: dotted;
    text-underline-offset: 3px;
    transition: color 0.2s ease;
  }

  .link-preview-trigger:hover {
    color: var(--color-secondary-text, #a1a1aa);
  }

  .link-preview-card {
    position: absolute;
    bottom: calc(100% + 12px);
    left: 50%;
    transform: translateX(-50%) scale(0.9);
    opacity: 0;
    pointer-events: none;
    transition: opacity 0.25s ease, transform 0.25s ease;
    z-index: 50;
    border-radius: 0.75rem;
    overflow: hidden;
    box-shadow: 0 10px 25px -5px rgba(0, 0, 0, 0.15),
      0 8px 10px -6px rgba(0, 0, 0, 0.1);
    border: 1px solid var(--color-border, #27272a);
    background-color: var(--color-card, #18181b);
  }

  .link-preview-wrapper:hover .link-preview-card {
    opacity: 1;
    transform: translateX(-50%) scale(1);
    pointer-events: auto;
  }

  .link-preview-image {
    display: block;
    width: 280px;
    height: 160px;
    object-fit: cover;
  }
</style>
