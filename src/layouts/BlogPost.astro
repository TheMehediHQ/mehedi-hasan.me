---
import { Image } from 'astro:assets';
import type { CollectionEntry } from 'astro:content';
import BaseHead from '../components/BaseHead.astro';
import Sidebar from '../components/layout/Sidebar.astro';
import BottomNav from '../components/layout/BottomNav.astro';
import MobileFooter from '../components/layout/MobileFooter.astro';
import FormattedDate from '../components/FormattedDate.astro';
import { Icon } from 'astro-icon/components';

type Props = CollectionEntry<'blog'>['data'];

const { title, description, pubDate, updatedDate, heroImage } = Astro.props;
---

<html lang="en">
  <head>
    <BaseHead title={`${title} — Mehedi Hasan`} description={description} />
  </head>

  <body>
    <div
      id="portfolio-layout"
      class="flex h-screen w-full overflow-hidden"
      style="background-color: var(--color-background);"
    >
      <!-- Desktop Sidebar -->
      <Sidebar />

      <!-- Main Content -->
      <main
        id="main-scroll-container"
        class="flex-1 overflow-y-auto scroll-smooth pb-24 lg:ml-[200px] lg:pb-0 xl:ml-[220px]"
      >
        <article>
          <!-- Hero Image -->
          {heroImage && (
            <div class="mb-8 mt-8 flex justify-center">
              <Image
                src={heroImage}
                alt=""
                width={600}
                height={340}
                class="rounded-xl object-cover"
                style="max-height: 280px; width: auto;"
              />
            </div>
          )}

          <div class="px-4 sm:px-8 lg:px-16 py-8 sm:py-12">
            <div class="max-w-3xl mx-auto">

              <!-- Back Link -->
              <a
                href="/blog"
                class="inline-flex items-center gap-1.5 text-sm mb-6 transition-colors duration-200 hover:opacity-70"
                style="color: var(--color-accent);"
              >
                <Icon name="lucide:arrow-left" size={14} />
                Back to Blog
              </a>

              <!-- Header -->
              <header class="mb-8 sm:mb-10">
                <div class="flex items-center gap-3 mb-3">
                  <Icon name="lucide:calendar" size={14} style="color: var(--color-muted-text);" />
                  <span class="text-sm" style="color: var(--color-muted-text);">
                    <FormattedDate date={pubDate} />
                  </span>
                  {updatedDate && (
                    <span class="text-xs italic" style="color: var(--color-muted-text);">
                      · Updated <FormattedDate date={updatedDate} />
                    </span>
                  )}
                </div>

                <h1
                  class="text-2xl sm:text-3xl lg:text-4xl font-bold leading-tight"
                  style="color: var(--color-primary-text);"
                >
                  {title}
                </h1>

                {description && (
                  <p class="mt-3 text-base sm:text-lg" style="color: var(--color-secondary-text);">
                    {description}
                  </p>
                )}
              </header>

              <!-- Post Content -->
              <div class="blog-prose">
                <slot />
              </div>

              <!-- Bottom Nav -->
              <div class="mt-12 pt-6" style="border-top: 1px solid var(--color-border);">
                <a
                  href="/blog"
                  class="inline-flex items-center gap-1.5 text-sm font-medium transition-colors duration-200 hover:opacity-70"
                  style="color: var(--color-accent);"
                >
                  <Icon name="lucide:arrow-left" size={14} />
                  All Posts
                </a>
              </div>

            </div>
          </div>
        </article>

        <MobileFooter />
      </main>

      <!-- Mobile Navigation -->
      <BottomNav />
    </div>
  </body>
</html>

<style>
  /* 🔹 Base container */
  .blog-prose {
    color: var(--color-secondary-text);
    font-family: system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, "Helvetica Neue", sans-serif;
    font-size: 1.125rem;
    line-height: 1.8;
    letter-spacing: 0.01em;
  }

  /* 🔹 Slot/Markdown এর ভিতরের হেডিংস */
  .blog-prose :global(h1),
  .blog-prose :global(h2),
  .blog-prose :global(h3),
  .blog-prose :global(h4),
  .blog-prose :global(h5),
  .blog-prose :global(h6) {
    color: var(--color-primary-text);
    font-weight: 700;
    margin-top: 2.5em;
    margin-bottom: 0.75em;
    line-height: 1.4;
    letter-spacing: -0.02em;
  }

  .blog-prose :global(h1) { 
    font-size: 2rem; 
    line-height: 1.3;
  }

  .blog-prose :global(h2) { 
    font-size: 1.625rem; 
    line-height: 1.35;
    padding-bottom: 0.4em;
    border-bottom: 1px solid var(--color-border);
  }

  .blog-prose :global(h3) { 
    font-size: 1.375rem; 
    line-height: 1.4;
  }

  /* 🔹 প্যারাগ্রাফ ও লিংক */
  .blog-prose :global(p) {
    margin-bottom: 1.5em;
    line-height: 1.8;
  }

  .blog-prose :global(a) {
    color: var(--color-accent);
    text-decoration: underline;
    text-underline-offset: 3px;
    text-decoration-thickness: 2px;
  }

  .blog-prose :global(a:hover) {
    opacity: 0.8;
  }

  .blog-prose :global(strong) {
    color: var(--color-primary-text);
    font-weight: 600;
  }

  /* 🔹 লিস্ট */
  .blog-prose :global(ul),
  .blog-prose :global(ol) {
    margin-bottom: 1.5em;
    padding-left: 1.75em;
    line-height: 1.8;
  }

  .blog-prose :global(li) {
    margin-bottom: 0.5em;
    line-height: 1.8;
  }

  .blog-prose :global(ul li) {
    list-style-type: disc;
  }

  .blog-prose :global(ol li) {
    list-style-type: decimal;
  }

  .blog-prose :global(blockquote) {
    border-left: 4px solid var(--color-accent);
    padding-left: 1.25em;
    margin: 2em 0;
    font-style: italic;
    color: var(--color-muted-text);
    line-height: 1.8;
  }

  /* 🔹 ইনলাইন কোড */
  .blog-prose :global(code:not(pre code)) {
    background-color: var(--color-hover);
    border: 1px solid var(--color-border);
    border-radius: 6px;
    padding: 0.2em 0.55em;
    margin: 0 0.1em;
    font-size: 0.875em;
    color: var(--color-primary-text);
    font-family: 'JetBrains Mono', 'Fira Code', Menlo, monospace;
    white-space: nowrap;
  }

  /* 🔹 কোড ব্লক (pre) */
  .blog-prose :global(pre) {
    background-color: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: 12px;
    padding: 1.5em 1.75em;
    margin: 1.75em 0;
    overflow-x: auto;
    line-height: 1.7;
  }

  .blog-prose :global(pre code) {
    background: none;
    border: none;
    padding: 0;
    margin: 0;
    font-size: 0.9rem;
    font-family: 'JetBrains Mono', 'Fira Code', Menlo, monospace;
    white-space: pre;
    display: block;
    text-wrap: pretty;
  }

  /* 🔹 ইমেজ, ডিভাইডার ও টেবিল */
  .blog-prose :global(img) {
    border-radius: 12px;
    margin: 2em 0;
    max-width: 100%;
    height: auto;
  }

  .blog-prose :global(hr) {
    border: none;
    border-top: 1px solid var(--color-border);
    margin: 2.5em 0;
  }

  .blog-prose :global(table) {
    width: 100%;
    border-collapse: collapse;
    margin: 1.75em 0;
    line-height: 1.6;
  }

  .blog-prose :global(th),
  .blog-prose :global(td) {
    border: 1px solid var(--color-border);
    padding: 0.6em 0.8em;
    text-align: left;
  }

  .blog-prose :global(th) {
    background-color: var(--color-hover);
    color: var(--color-primary-text);
    font-weight: 600;
  }

  /* 🔹 ডার্ক মোড ও সিনট্যাক্স হাইলাইটিং */
  .blog-prose :global(.astro-code:not(.github-dark) span[style*="color:#6C757D"]) {
    color: #495057 !important;
  }

  :global(.dark) .blog-prose :global(pre) {
    background-color: #0d1117 !important;
    border-color: rgba(255, 255, 255, 0.1);
  }

  :global(.dark) .blog-prose :global(pre code) {
    color: #ffffff;
    font-weight: 500;
  }

  :global(.dark) .blog-prose :global(.astro-code.github-dark code span) { color: #e1e4e8 !important; }
  :global(.dark) .blog-prose :global(.astro-code.github-dark [style*="--shiki-dark:#6A737D"]) { color: #bbc7d3 !important; }
  :global(.dark) .blog-prose :global(.astro-code.github-dark [style*="--shiki-dark:#9ECBFF"]),
  :global(.dark) .blog-prose :global(.astro-code.github-dark [style*="--shiki-dark:#79B8FF"]) { color: #a5d6ff !important; }
  :global(.dark) .blog-prose :global(.astro-code.github-dark [style*="--shiki-dark:#F97583"]),
  :global(.dark) .blog-prose :global(.astro-code.github-dark [style*="--shiki-dark:#FF7B72"]) { color: #ff7b82 !important; }
  :global(.dark) .blog-prose :global(.astro-code.github-dark [style*="--shiki-dark:#B392F0"]),
  :global(.dark) .blog-prose :global(.astro-code.github-dark [style*="--shiki-dark:#D2A8FF"]) { color: #d2a8ff !important; }
  :global(.dark) .blog-prose :global(.astro-code.github-dark [style*="--shiki-dark:#FFAB70"]),
  :global(.dark) .blog-prose :global(.astro-code.github-dark [style*="--shiki-dark:#FFA657"]) { color: #ffa657 !important; }
  :global(.dark) .blog-prose :global(.shiki.dark span[style*="color"]) { color: #e6edf3 !important; }
</style>