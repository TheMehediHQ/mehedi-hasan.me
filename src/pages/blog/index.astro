---
import { Image } from 'astro:assets';
import { getCollection } from 'astro:content';
import BaseHead from '../../components/BaseHead.astro';
import Sidebar from '../../components/layout/Sidebar.astro';
import BottomNav from '../../components/layout/BottomNav.astro';
import MobileFooter from '../../components/layout/MobileFooter.astro';
import FormattedDate from '../../components/FormattedDate.astro';
import { Icon } from 'astro-icon/components';
import { SITE_DESCRIPTION, SITE_TITLE } from '../../consts';

const posts = (await getCollection('blog')).sort(
  (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf(),
);
---

<!doctype html>
<html lang="en">


  <BaseHead
  title={SITE_TITLE}
  description={SITE_DESCRIPTION}
/>

  <body>
    <div
      id="portfolio-layout"
      class="flex h-screen w-full overflow-hidden"
      style="background-color: var(--color-background);"
    >
      <!-- Desktop Sidebar -->
      <Sidebar />

      <!-- Main Content -->
      <main
        id="main-scroll-container"
        class="flex-1 overflow-y-auto scroll-smooth pb-24 lg:ml-[200px] lg:pb-0 xl:ml-[220px]"
      >
        <div class="px-4 sm:px-8 lg:px-16 py-8 sm:py-12">
          <div class="max-w-4xl mx-auto">

            <!-- Page Title -->
            <div class="mb-8 sm:mb-10">
              <h1
                class="text-2xl sm:text-3xl font-bold mb-2"
                style="color: var(--color-primary-text);"
              >
                Blog
              </h1>
              <p class="text-sm sm:text-base" style="color: var(--color-secondary-text);">
                Writing code and sharing the journey.
              </p>
            </div>

            <!-- Posts Grid -->
            <div class="flex flex-col gap-6">
              {posts.map((post) => (
                <a
                  href={`/blog/${post.id}/`}
                  class="group block rounded-2xl p-5 sm:p-6 transition-all duration-300"
                  style=" background-color: var(--color-card);"
                >
                  <div class="flex flex-col sm:flex-row gap-4 sm:gap-6">
                    <!-- Hero Image -->
                    {post.data.heroImage && (
                      <div class="sm:w-48 sm:h-32 flex-shrink-0 rounded-xl overflow-hidden bg-[var(--color-hover)]">
                        <Image
                          src={post.data.heroImage}
                          alt=""
                          width={400}
                          height={250}
                          class="w-full h-full object-cover transition-transform duration-500 group-hover:scale-105"
                        />
                      </div>
                    )}

                    <!-- Content -->
                    <div class="flex-1 flex flex-col justify-center">
                      <div class="flex items-center gap-2 mb-2">
                        <Icon name="lucide:calendar" size={12} style="color: var(--color-muted-text);" />
                        <span class="text-xs" style="color: var(--color-muted-text);">
                          <FormattedDate date={post.data.pubDate} />
                        </span>
                      </div>

                      <h2
                        class="text-lg sm:text-xl font-semibold mb-2 transition-colors duration-200"
                        style="color: var(--color-primary-text);"
                      >
                        {post.data.title}
                      </h2>

                      {post.data.description && (
                        <p class="text-sm leading-6 line-clamp-2" style="color: var(--color-secondary-text);">
                          {post.data.description}
                        </p>
                      )}

                      <div class="mt-3 flex items-center gap-1 text-xs font-medium transition-colors duration-200" style="color: var(--color-accent);">
                        Read more
                        <Icon name="lucide:arrow-right" size={12} />
                      </div>
                    </div>
                  </div>
                </a>
              ))}
            </div>

          </div>
        </div>

        <MobileFooter />
      </main>

      <!-- Mobile Navigation -->
      <BottomNav />
    </div>
  </body>
</html>
