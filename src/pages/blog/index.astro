---
import { Image } from 'astro:assets';
import { getCollection } from 'astro:content';
import BaseHead from '../../components/BaseHead.astro';
import TopNav from '../../components/layout/TopNav.astro';
import MobileFooter from '../../components/layout/MobileFooter.astro';
import GradientFooter from '../../components/layout/GradientFooter.astro';
import FormattedDate from '../../components/FormattedDate.astro';
import { Icon } from 'astro-icon/components';
import Newsletter from '../../components/Newsletter.astro';
import Chatbot from '../../components/chat/Chatbot.astro';
import { SITE_DESCRIPTION, SITE_TITLE } from '../../consts';

const posts = (await getCollection('blog')).sort(
  (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf(),
);

const categories = [...new Set(posts.map((p) => p.data.category))];
---

<!doctype html>
<html lang="en">


  <BaseHead
  title={SITE_TITLE}
  description={SITE_DESCRIPTION}
/>

  <body>
    <div
      id="portfolio-layout"
      class="flex h-screen w-full overflow-hidden"
      style="background-color: var(--color-background);"
    >
      <!-- Main Content -->
      <main
        id="main-scroll-container"
        class="flex-1 overflow-y-auto scroll-smooth lg:pb-0"
      >
        <!-- Top Navigation -->
        <TopNav />

        <div class="px-4 sm:px-8 lg:px-16 py-8 sm:py-12">
          <div class="max-w-3xl mx-auto">

            <!-- Page Title -->
            <div class="mb-8 sm:mb-10">
              <h1
                class="text-2xl sm:text-3xl font-bold mb-2"
                style="color: var(--color-primary-text);"
              >
                Blog
              </h1>
              <p class="text-sm sm:text-base" style="color: var(--color-secondary-text);">
                Writing code and sharing the journey.
              </p>
            </div>

            <!-- Search & Filter -->
            <div class="mb-6 flex flex-col gap-4">
              <!-- Search Input -->
              <div
                class="flex items-center gap-2.5 h-11 sm:h-12 rounded-xl border border-[var(--color-border)] px-3.5 transition-colors focus-within:border-[var(--color-primary-text)]"
                style="background-color: transparent;"
              >
                <Icon
                  name="lucide:search"
                  size={16}
                  class="shrink-0 pointer-events-none"
                  style="color: var(--color-muted-text);"
                />
                <input
                  id="blog-search"
                  type="text"
                  inputmode="search"
                  placeholder="Search posts..."
                  class="w-full min-w-0 bg-transparent text-sm placeholder:text-[var(--color-secondary-text)] focus:outline-none"
                  style="color: var(--color-primary-text);"
                />
              </div>

              <!-- Category Filters -->
              <div class="-mx-4 px-4 sm:mx-0 sm:px-0 overflow-x-auto scrollbar-none">
                <div class="flex gap-2 w-max sm:flex-wrap sm:w-auto">
                  <button
                    data-category="all"
                    class="blog-filter-btn shrink-0 rounded-full px-3.5 py-2 text-xs font-medium transition-all duration-200 sm:py-1.5"
                    style="background-color: var(--color-hover); color: var(--color-primary-text);"
                  >
                    All
                  </button>
                  {categories.map((cat) => (
                    <button
                      data-category={cat}
                      class="blog-filter-btn shrink-0 rounded-full px-3.5 py-2 text-xs font-medium transition-all duration-200 sm:py-1.5"
                      style="background-color: var(--color-card); color: var(--color-secondary-text);"
                    >
                      {cat}
                    </button>
                  ))}
                </div>
              </div>

              <!-- Post Count -->
              <p
                id="blog-post-count"
                class="text-xs"
                style="color: var(--color-muted-text);"
              >
                {posts.length} {posts.length === 1 ? 'post' : 'posts'} found
              </p>
            </div>

            <!-- Posts Grid -->
            <div id="blog-posts-grid" class="flex flex-col gap-6">
              {posts.map((post) => (
                <a
                  href={`/blog/${post.id}/`}
                  data-blog-post
                  data-category={post.data.category}
                  data-title={post.data.title.toLowerCase()}
                  data-description={(post.data.description || '').toLowerCase()}
                  data-tags={post.data.tags.join(',').toLowerCase()}
                  class="blog-post-card group block rounded-2xl p-5 sm:p-6 transition-all duration-300"
                  style="background-color: var(--color-card);"
                >
                  <div class="flex flex-col sm:flex-row gap-4 sm:gap-6">
                    <!-- Hero Image -->
                     {post.data.heroImage && (
                       <div class="w-full sm:w-48 aspect-[16/10] flex-shrink-0 rounded-xl overflow-hidden bg-[var(--color-hover)]">
                         <Image
                           src={post.data.heroImage}
                           alt={post.data.title}
                           width={400}
                           height={250}
                           loading="lazy"
                           class="w-full h-full object-cover transition-transform duration-500 group-hover:scale-105"
                         />
                       </div>
                     )}

                    <!-- Content -->
                    <div class="flex-1 flex flex-col justify-center">
                      <div class="flex items-center gap-2 mb-2">
                        <Icon name="lucide:calendar" size={12} style="color: var(--color-muted-text);" />
                        <span class="text-xs" style="color: var(--color-muted-text);">
                          <FormattedDate date={post.data.pubDate} />
                        </span>
                        <span
                          class="rounded-full px-2 py-0.5 text-[10px] font-medium"
                          style="background-color: var(--color-hover); color: var(--color-secondary-text);"
                        >
                          {post.data.category}
                        </span>
                      </div>

                      <h2
                        class="text-lg sm:text-xl font-semibold mb-2 transition-colors duration-200"
                        style="color: var(--color-primary-text);"
                      >
                        {post.data.title}
                      </h2>

                      {post.data.description && (
                        <p class="text-sm leading-6 line-clamp-2" style="color: var(--color-secondary-text);">
                          {post.data.description}
                        </p>
                      )}

                      <div class="mt-3 flex items-center gap-1 text-xs font-medium transition-colors duration-200" style="color: var(--color-accent);">
                        Read more
                        <Icon name="lucide:arrow-right" size={12} />
                      </div>
                    </div>
                  </div>
                </a>
              ))}
            </div>

            <!-- Empty State -->
            <div
              id="blog-empty-state"
              class="hidden flex-col items-center justify-center py-16 text-center"
            >
              <Icon
                name="lucide:search-x"
                size={40}
                style="color: var(--color-muted-text);"
              />
              <p
                class="mt-4 text-sm font-medium"
                style="color: var(--color-secondary-text);"
              >
                No posts found
              </p>
              <p
                class="mt-1 text-xs"
                style="color: var(--color-muted-text);"
              >
                Try a different search term or category.
              </p>
            </div>

            <!-- Newsletter -->
            <div class="mt-12">
              <Newsletter />
            </div>

          </div>
        </div>

        <MobileFooter />
        <GradientFooter />
      </main>

      <!-- AI Portfolio Assistant Chatbot -->
      <Chatbot />
    </div>
  </body>
</html>

<style>
  .blog-post-card[hidden] {
    display: none;
  }

  .scrollbar-none {
    -ms-overflow-style: none;
    scrollbar-width: none;
  }
  .scrollbar-none::-webkit-scrollbar {
    display: none;
  }

</style>

<script>
  const searchInput = document.getElementById("blog-search") as HTMLInputElement;
  const filterButtons = document.querySelectorAll(".blog-filter-btn");
  const postCards = document.querySelectorAll("[data-blog-post]");
  const postCount = document.getElementById("blog-post-count");
  const emptyState = document.getElementById("blog-empty-state");
  const postsGrid = document.getElementById("blog-posts-grid");

  let activeCategory = "all";

  function filterPosts() {
    const query = searchInput.value.toLowerCase().trim();
    let visibleCount = 0;

    postCards.forEach((card) => {
      const el = card as HTMLElement;
      const category = el.dataset.category || "";
      const title = el.dataset.title || "";
      const description = el.dataset.description || "";
      const tags = el.dataset.tags || "";

      const matchesCategory =
        activeCategory === "all" || category === activeCategory;
      const matchesSearch =
        !query ||
        title.includes(query) ||
        description.includes(query) ||
        tags.includes(query);

      if (matchesCategory && matchesSearch) {
        el.removeAttribute("hidden");
        visibleCount++;
      } else {
        el.setAttribute("hidden", "");
      }
    });

    if (postCount) {
      postCount.textContent = `${visibleCount} ${visibleCount === 1 ? "post" : "posts"} found`;
    }

    if (postsGrid) {
      postsGrid.classList.toggle("hidden", visibleCount === 0);
    }
    if (emptyState) {
      emptyState.classList.toggle("hidden", visibleCount > 0);
      emptyState.classList.toggle("flex", visibleCount === 0);
    }
  }

  searchInput?.addEventListener("input", filterPosts);

  filterButtons.forEach((btn) => {
    btn.addEventListener("click", () => {
      activeCategory = (btn as HTMLElement).dataset.category || "all";

      filterButtons.forEach((b) => {
        b.style.backgroundColor = "var(--color-card)";
        b.style.color = "var(--color-secondary-text)";
      });
      btn.style.backgroundColor = "var(--color-hover)";
      btn.style.color = "var(--color-primary-text)";

      filterPosts();
    });
  });
</script>
