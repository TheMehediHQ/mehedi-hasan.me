---
import BaseHead from "../components/BaseHead.astro";
import MobileFooter from "../components/layout/MobileFooter.astro";
import Chatbot from "../components/chat/Chatbot.astro";
import ContactSection from "../sections/ContactSection.astro";
import IndexLink from "@/components/ui/IndexLink.astro";
import { Icon } from "astro-icon/components";
---

<!doctype html>
<html lang="en">
<head>
  <BaseHead
    title="Contact — Mehedi Hasan"
    description="Get in touch with Mehedi Hasan. Available for full-time opportunities and collaborations."
  />
</head>

<body>
  <div
    class="flex min-h-screen w-full flex-col"
    style="background-color: var(--color-background);"
  >
    <!-- Index Button + Content (blog-style grid) -->
    <div class="px-4 sm:px-8 lg:px-16 pt-8 sm:pt-12">
      <div class="max-w-4xl mx-auto grid grid-cols-1 sm:grid-cols-[120px_1fr] gap-8 sm:gap-6">
        <!-- Index Button (left column on desktop) -->
        <div>
          <IndexLink />
        </div>

        <!-- Contact Content (right column on desktop) -->
        <div>
          <!-- Page Title -->
          <div class="mb-8 sm:mb-10">
            <h1
              class="text-2xl sm:text-3xl font-bold mb-2"
              style="color: var(--color-primary-text);"
            >
              Contact
            </h1>
            <p class="text-sm sm:text-base" style="color: var(--color-secondary-text);">
              Get in touch. Available for full-time opportunities and collaborations.
            </p>
          </div>

          <ContactSection />
        </div>
      </div>
    </div>

    <MobileFooter />
    <Chatbot />
  </div>
</body>
</html>
