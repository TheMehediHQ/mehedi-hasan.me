---
import SectionTitle from "@/components/ui/SectionTitle.astro";
import ExperienceCard from "@/components/ui/ExperienceCard.astro";
import { experiences, experiencesBn } from "@/data/experience";
import { useTranslations } from "@/i18n/ui";

const currentLocale = Astro.currentLocale ?? "en";
const t = useTranslations(currentLocale);
const currentExperiences = currentLocale === "bn" ? experiencesBn : experiences;
---

<div class="px-4 sm:px-8 lg:px-16 py-8 sm:py-12">
  <div class="max-w-3xl mx-auto">
    <SectionTitle title={t("section.experience")} subtitle="" />

    <div class="space-y-6 lg:space-y-10">
      {currentExperiences.map((experience, index) => (
        <ExperienceCard experience={experience} index={index} />
      ))}
    </div>
  </div>
</div>
