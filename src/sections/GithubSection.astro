---
import SectionTitle from "@/components/ui/SectionTitle.astro";
---

<div class="px-4 sm:px-8 lg:px-16 py-8 sm:py-12">
  <div class="max-w-4xl mx-auto">
    <SectionTitle title="GitHub Activity" subtitle="" />

    <div class="mt-6 lg:mt-10 overflow-x-auto">
      <div class="rounded-lg overflow-hidden">
        <img
          src="https://ghchart.rshah.org/themehedihq"
          alt="Mehedi Hasan's GitHub Contribution Graph"
          class="w-full h-auto"
          loading="lazy"
        />
      </div>
    </div>
  </div>
</div>
