---
import SectionTitle from "@/components/ui/SectionTitle.astro";
import { useTranslations } from "@/i18n/ui";

const currentLocale = Astro.currentLocale ?? "en";
const t = useTranslations(currentLocale);
---

<div class="px-4 sm:px-8 lg:px-16 py-8 sm:py-12">
  <div class="max-w-3xl mx-auto">
    <SectionTitle title={t("section.github")} subtitle="" />

    <div class="mt-6 lg:mt-10 overflow-x-auto">
      <div class="rounded-lg overflow-hidden">
        <img
          src="https://ghchart.rshah.org/0A84FF/themehedihq"
          alt="Mehedi Hasan's GitHub Contribution Graph"
          class="w-full h-auto"
          loading="lazy"
        />
      </div>
    </div>
  </div>
</div>
