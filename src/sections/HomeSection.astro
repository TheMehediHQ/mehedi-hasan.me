
---
import { personalInfo } from "../data/personalInfo";
import { socials } from "../data/socials";
import HeroCTA from "../components/ui/HeroCTA.astro";

const currentLocale = Astro.currentLocale ?? "en";
const isBn = currentLocale === "bn";
---

<section
  id="home"
  data-home-section
  class="flex min-h-full items-center justify-center px-4 py-8 sm:px-8 sm:py-12 lg:px-16"
>
  <div class="w-full max-w-3xl">
    <div
      class="grid grid-cols-1 items-center gap-7 md:grid-cols-[1fr_auto] md:gap-10 lg:gap-16"
    >

      <!-- PROFILE IMAGE -->
      <div
        class="home-animate order-first flex justify-start md:order-last md:justify-end"
        data-delay="0.1s"
      >
        <div
          class="relative h-24 w-24 overflow-hidden rounded-3xl border border-[var(--color-border)] bg-[var(--color-surface)] sm:h-28 sm:w-28 md:h-32 md:w-32"
        >
          <img
            src={personalInfo.profile}
            alt="Mehedi Hasan"
            width={2500}
            height={2500}
            loading="lazy"
            class="h-full w-full object-cover"
          />
        </div>
      </div>

      <!-- LEFT / MAIN CONTENT -->
      <div class="order-last text-center md:order-first md:text-left">

        <!-- Greeting -->
        <h1
          class="home-animate mb-4 text-left text-xl font-bold leading-tight sm:text-xl md:text-2xl lg:text-3xl"
          data-delay="0.2s"
          style="color: var(--color-primary-text);"
        >
          {isBn ? "হ্যালো!" : "Hello there!"} <img src="/images/wave.gif" alt="Wave" class="inline-block w-7 h-7 sm:w-8 sm:h-8 -mt-1 align-middle" />
        </h1>
        <h1
          class="home-animate mb-4 text-left text-xl font-bold leading-tight sm:text-2xl md:text-3xl lg:text-4xl"
          data-delay="0.2s"
          style="color: var(--color-primary-text);"
        >
          {isBn ? "আমি মেহেদী হাসান।" : "I'm Mehedi Hasan."}
        </h1>

        <!-- Bio -->
        <div
          class="home-animate mb-7 space-y-3 text-left sm:mb-8 sm:space-y-4"
          data-delay="0.3s"
        >
          <p
            class="text-sm leading-6 sm:text-base sm:leading-7"
            style="color: var(--color-secondary-text);"
          >
            {
              isBn ? (
                <>
                 বাংলাদেশের ঢাকাতে  <img src="/icon/flag.svg" alt="Bangladesh" class="inline w-6 h-5 align-middle mx-0.5" /> বসে আমি সফটওয়্যার ইঞ্জিনিয়ার হিসেবে কাজ করছি গ্লোবাল প্রতিষ্ঠানের সাথে । স্কেলেবল ওয়েব অ্যাপ্লিকেশন তৈরি, ব্যাকএন্ড সিস্টেম আর্কিটেকচার এবং বাস্তব সমস্যার সমাধানে কৃত্রিম বুদ্ধিমত্তা (AI) ইন্টিগ্রেশনে আমার কয়েক বছরের অভিজ্ঞতা রয়েছে।
                </>
              ) : (
                <>
                  I'm a Software Engineer from Dhaka, Bangladesh <img src="/icon/flag.svg" alt="Bangladesh" class="inline w-6 h-5 align-middle mx-0.5" /> with years of experience building scalable web applications, developing backend systems, and integrating AI to solve real-world problems.
                </>
              )
            }
          </p>

          <p
            class="text-sm leading-6 sm:text-base sm:leading-7"
            style="color: var(--color-secondary-text);"
          >
            {
              isBn
                ? "আমি বিভিন্ন দলের সাথে কাজ করেছি, নতুন নতুন প্রযুক্তিগত চ্যালেঞ্জ মোকাবিলা করেছি এবং প্রতিনিয়ত নতুন কিছু শিখে নিজেকে সমৃদ্ধ করেছি।"
                : "I've worked with different teams, taken on new challenges, and learned a lot along the way."
            }
          </p>
          <p
            class="text-sm leading-6 sm:text-base sm:leading-7"
            style="color: var(--color-secondary-text);"
          >
            {
              isBn
                ? "কোডিংয়ের বাইরে আমি সমাজসেবামূলক কাজে যুক্ত থাকতে এবং নতুন নতুন জায়গা ঘুরে দেখতে ভালোবাসি।"
                : "When I'm not coding, I enjoy helping others through social work or exploring new places."
            }
          </p>
        </div>

        <!-- CTA -->
        <div
          class="home-animate flex justify-center md:justify-start"
          data-delay="0.4s"
        >
          <HeroCTA
            items={[
              {
                label: "hello@mehedi-hasan.me",
                href: "mailto:hello@mehedi-hasan.me",
              },
              ...socials.map((s) => {
                const previewMap: Record<string, string> = {
                  LinkedIn: "/images/linkedin.webp",
                  GitHub: "/images/github.webp",
                  X: "/images/x.webp",
                };

                return previewMap[s.label]
                  ? { ...s, previewImage: previewMap[s.label] }
                  : s;
              }),
              {
                label: "Resume",
                href: personalInfo.resume,
              },
            ]}
          />
        </div>

      </div>
    </div>
  </div>
</section>

<style>
  .home-animate {
    opacity: 0;
    transform: translateY(20px);
    transition:
      opacity 0.6s ease,
      transform 0.6s ease;
  }

  [data-home-section].is-visible .home-animate {
    opacity: 1;
    transform: translateY(0);
    transition-delay: var(--animation-delay);
  }
</style>

<script>
  const homeSection = document.querySelector("[data-home-section]");

  if (homeSection) {
    const animatedElements =
      homeSection.querySelectorAll<HTMLElement>(".home-animate");

    animatedElements.forEach((element) => {
      const delay = element.dataset.delay;

      if (delay) {
        element.style.setProperty("--animation-delay", delay);
      }
    });

    const observer = new IntersectionObserver(
      ([entry]) => {
        if (entry.isIntersecting) {
          homeSection.classList.add("is-visible");
          observer.disconnect();
        }
      },
      {
        threshold: 0.15,
      }
    );

    observer.observe(homeSection);
  }
</script>