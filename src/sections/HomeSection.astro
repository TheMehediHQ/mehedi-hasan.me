---
import { personalInfo } from "../data/personalInfo";
import { socials } from "../data/socials";
import HeroCTA from "../components/ui/HeroCTA.astro";
---

<section
  id="home"
  data-home-section
  class="flex min-h-full items-center justify-center px-4 py-8 sm:px-8 sm:py-12 lg:px-16"
>
  <div class="w-full max-w-4xl">

    <!-- Signature -->
    <div
      class="home-animate mb-8 mt-3 flex w-full justify-start"
      data-delay="0.1s"
    >
      <img
        src={personalInfo.signature}
        alt="Mehedi Hasan signature"
        width={806}
        height={574}
        loading="eager"
        fetchpriority="high"
        class="h-auto w-20 opacity-90 sm:w-24 md:w-26 lg:w-28 xl:w-28"
      />
    </div>

    <!-- Title -->
    <p
      class="home-animate mb-3 text-lg leading-6 sm:mb-4 sm:text-xl lg:text-2xl"
      data-delay="0.2s"
      style="color: var(--color-secondary-text);"
    >
      {personalInfo.title}
    </p>

    <!-- Bio -->
    <p
      class="home-animate mb-8 max-w-2xl text-sm leading-6 sm:mb-10 sm:text-base"
      data-delay="0.3s"
      style="color: var(--color-secondary-text);"
    >
      {personalInfo.bio}
    </p>

    <!-- CTA -->
    <div
      class="home-animate"
      data-delay="0.4s"
    >
      <HeroCTA
        items={[
          {
            label: "hello@mehedi-hasan.me",
            href: "mailto:hello@mehedi-hasan.me",
          },
          ...socials.map((s) => {
            const previewMap: Record<string, string> = {
              LinkedIn: "/images/linkedin.webp",
              GitHub: "/images/github.webp",
              X: "/images/x.webp",
            };
            return previewMap[s.label]
              ? { ...s, previewImage: previewMap[s.label] }
              : s;
          }),
          {
            label: "Resume",
            href: personalInfo.resume,
          },
        ]}
      />
    </div>

  </div>
</section>

<style>
  .home-animate {
    opacity: 0;
    transform: translateY(20px);
    transition:
      opacity 0.6s ease,
      transform 0.6s ease;
  }

  [data-home-section].is-visible .home-animate {
    opacity: 1;
    transform: translateY(0);
    transition-delay: var(--animation-delay);
  }
</style>

<script>
  const homeSection = document.querySelector("[data-home-section]");

  if (homeSection) {
    const animatedElements =
      homeSection.querySelectorAll<HTMLElement>(".home-animate");

    animatedElements.forEach((element) => {
      const delay = element.dataset.delay;

      if (delay) {
        element.style.setProperty("--animation-delay", delay);
      }
    });

    const observer = new IntersectionObserver(
      ([entry]) => {
        if (entry.isIntersecting) {
          homeSection.classList.add("is-visible");
          observer.disconnect();
        }
      },
      {
        threshold: 0.15,
      }
    );

    observer.observe(homeSection);
  }
</script>