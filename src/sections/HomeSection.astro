---
import { personalInfo } from "../data/personalInfo";
import { socials } from "../data/socials";
import HeroCTA from "../components/ui/HeroCTA.astro";
---

<section
  id="home"
  data-home-section
  class="flex min-h-full items-center justify-center px-4 py-8 sm:px-8 sm:py-12 lg:px-16"
>
  <div class="w-full max-w-4xl">

    <div class="grid grid-cols-1 items-center gap-8 md:grid-cols-[1fr_auto] md:gap-20">

      <!-- LEFT CONTENT -->
      <div>

        <!-- Greeting -->
        <h1
          class="home-animate mb-3 text-2xl font-bold leading-tight sm:mb-4 sm:text-3xl lg:text-4xl"
          data-delay="0.1s"
          style="color: var(--color-primary-text);"
        >
          👋 Hello there! I'm Mehedi Hasan
        </h1>

        <!-- Title -->
      

        <!-- Bio -->
        <div
          class="home-animate space-y-4 mb-8 sm:mb-10"
          data-delay="0.3s"
        >
          <p class="text-sm leading-7 sm:text-base" style="color: var(--color-secondary-text);">
            I'm a <span class="font-semibold" style="color: var(--color-primary-text);">Full-Stack & AI Developer</span> from Dhaka, Bangladesh. I love building <span class="rounded-md px-1.5 py-0.5 text-sm" style="background-color: var(--color-hover); color: var(--color-primary-text);">scalable web apps</span> and integrating AI into real-world products.
          </p>
          <p class="text-sm leading-7 sm:text-base" style="color: var(--color-secondary-text);">
            Passionate about <span class="rounded-md px-1.5 py-0.5 text-sm" style="background-color: var(--color-hover); color: var(--color-primary-text);">LLM integration</span>, clean code, and creating tools that solve real problems.
          </p>
        </div>

        <!-- CTA -->
        <div
          class="home-animate"
          data-delay="0.4s"
        >
          <HeroCTA
            items={[
              {
                label: "hello@mehedi-hasan.me",
                href: "mailto:hello@mehedi-hasan.me",
              },
              ...socials.map((s) => {
                const previewMap: Record<string, string> = {
                  LinkedIn: "/images/linkedin.webp",
                  GitHub: "/images/github.webp",
                  X: "/images/x.webp",
                };

                return previewMap[s.label]
                  ? { ...s, previewImage: previewMap[s.label] }
                  : s;
              }),
              {
                label: "Resume",
                href: personalInfo.resume,
              },
            ]}
          />
        </div>

      </div>

      <!-- RIGHT / PROFILE IMAGE -->
      <div class="home-animate flex justify-start md:justify-end" data-delay="0.5s">
        <div
          class="relative h-24 w-24 overflow-hidden rounded-3xl border border-[var(--color-border)] bg-[var(--color-surface)] sm:h-28 sm:w-28 md:h-32 md:w-32"
        >
          <img
            src={personalInfo.profile}
            alt="Mehedi Hasan"
            width={2500}
            height={2500}
            loading="lazy"
            class="h-full w-full object-cover"
          />
        </div>
      </div>

    </div>

  </div>
</section>

<style>
  .home-animate {
    opacity: 0;
    transform: translateY(20px);
    transition:
      opacity 0.6s ease,
      transform 0.6s ease;
  }

  [data-home-section].is-visible .home-animate {
    opacity: 1;
    transform: translateY(0);
    transition-delay: var(--animation-delay);
  }
</style>

<script>
  const homeSection = document.querySelector("[data-home-section]");

  if (homeSection) {
    const animatedElements =
      homeSection.querySelectorAll<HTMLElement>(".home-animate");

    animatedElements.forEach((element) => {
      const delay = element.dataset.delay;

      if (delay) {
        element.style.setProperty("--animation-delay", delay);
      }
    });

    const observer = new IntersectionObserver(
      ([entry]) => {
        if (entry.isIntersecting) {
          homeSection.classList.add("is-visible");
          observer.disconnect();
        }
      },
      {
        threshold: 0.15,
      }
    );

    observer.observe(homeSection);
  }
</script>