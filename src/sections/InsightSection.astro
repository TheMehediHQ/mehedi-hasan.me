---
import SectionTitle from "@/components/ui/SectionTitle.astro";
import LocationCard from "@/components/live-signals/LocationCard.astro";
import LastFmCard from "@/components/live-signals/LastFmCard.astro";
import DhakaTimeCard from "@/components/live-signals/DhakaTimeCard.astro";
---

<section class="px-4 sm:px-8 lg:px-16 py-8 sm:py-12">
  <div class="max-w-3xl mx-auto">
    <SectionTitle title="Live Signals" subtitle="" />

    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-5">
     <DhakaTimeCard />
      <LocationCard />
      <LastFmCard />
    </div>
  </div>
</section>
